function isOwnProduct(p){
  if (!p) return false;
  const sid = (p.seller_id !== undefined && p.seller_id !== null) ? p.seller_id : p.owner_id;
  return (sid !== undefined && sid !== null && state.telegram_id !== undefined && state.telegram_id !== null)
         && String(sid) === String(state.telegram_id);
}

/* hours left before auto-release (display only) */
function escrowHoursLeft(o){
  if (!o || !o.release_at) return 48;
  const t = new Date(o.release_at).getTime();
  if (isNaN(t)) return 48;
  return Math.max(0, Math.ceil((t - Date.now()) / 3600000));
}

