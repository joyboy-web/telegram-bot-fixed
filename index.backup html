/* ===================== 13. PASSCODE ENGINE (one passcode for everything) ===================== */
const PC_BLOCKS = [5, 15, 30];   // minutes: first block 5, then 15, then 30 (stays 30)
function pcGet(){ return b7Load('pc', { on: false, hash: null, fails: 0, level: 0, until: 0 }); }
function pcSet(s){ b7Save('pc', s); }
function pcOn(){ const s = pcGet(); return !!(s.on && s.hash); }
function pcClear(){ pcSet({ on: false, hash: null, fails: 0, level: 0, until: 0 }); }
function pcRemaining(){ const s = pcGet(); return Math.max(0, (s.until || 0) - Date.now()); }
function pcFmt(ms){
  const t = Math.ceil(ms / 1000), m = Math.floor(t / 60), s = t % 60;
  return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
}
async function pcHash(pin){
  const raw = 'paylock:' + b7Uid() + ':' + pin;
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
    return Array.from(new Uint8Array(buf)).map(function(b){ return b.toString(16).padStart(2, '0'); }).join('');
  } catch (e) {
    let h = 5381;
    for (let i = 0; i < raw.length; i++) h = ((h << 5) + h + raw.charCodeAt(i)) | 0;
    return 'f' + h;
  }
}
// Wrong 1x "Try again", wrong 2x "1 attempt left", wrong 3x block 5 -> 15 -> 30 minutes
async function pcCheck(pin){
  const s = pcGet();
  const rem = pcRemaining();
  if (rem > 0) return { status: 'blocked', ms: rem };
  const h = await pcHash(pin);
  if (s.hash && h === s.hash) { s.fails = 0; s.level = 0; s.until = 0; pcSet(s); return { status: 'ok' }; }
  s.fails = (s.fails || 0) + 1;
  if (s.fails >= 3) {
    const mins = PC_BLOCKS[Math.min(s.level || 0, PC_BLOCKS.length - 1)];
    s.level = (s.level || 0) + 1;
    s.fails = 0;
    s.until = Date.now() + mins * 60000;
    pcSet(s);
    return { status: 'blocked', ms: mins * 60000 };
  }
  pcSet(s);
  return { status: 'wrong', left: 3 - s.fails };
}
async function pcSetPin(pin){
  const s = pcGet();
  s.hash = await pcHash(pin);
  s.on = true; s.fails = 0; s.level = 0; s.until = 0;
  pcSet(s);
  b7Soft('/api/passcode/set', { passcode_hash: s.hash });   // MISSING route: silently ignored until Prompt 2
}
// Generic 4-digit pad. cfg: dots, err, timer (ids), keypad (id), locked() -> ms, onDone(pin)
function pinPad(c){
  const P = { value: '', busy: false, tmr: null };
  const kp = $(c.keypad);
  clearNode(kp);
  ['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', 'back'].forEach(function(k){
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'key';
    if (k === '') { b.className = 'key blank'; b.disabled = true; }
    else if (k === 'back') b.appendChild(svgIcon(ICON_BACKSPACE, 24));
    else b.textContent = k;
    b.addEventListener('click', function(){ P.key(k); });
    kp.appendChild(b);
  });
  P.draw = function(){
    const d = $(c.dots).children;
    for (let i = 0; i < d.length; i++) d[i].classList.toggle('filled', i < P.value.length);
  };
  P.error = function(m){ const e = $(c.err); if (e) e.textContent = m || ''; };
  P.reset = function(){ P.value = ''; P.busy = false; P.draw(); };
  P.lockedNow = function(){ return typeof c.locked === 'function' ? c.locked() : 0; };
  P.showLock = function(ms){
    const tEl = c.timer ? $(c.timer) : null;
    if (!tEl) return;
    const end = Date.now() + ms;
    clearInterval(P.tmr);
    function tick(){
      const rem = end - Date.now();
      if (rem <= 0) {
        clearInterval(P.tmr);
        tEl.style.display = 'none';
        kp.style.opacity = '';
        kp.style.pointerEvents = '';
        P.error('');
        return;
      }
      tEl.style.display = 'block';
      tEl.textContent = 'Try again in ' + pcFmt(rem);
      kp.style.opacity = '.35';
      kp.style.pointerEvents = 'none';
      P.error('Too many attempts');
    }
    tick();
    P.tmr = setInterval(tick, 500);
  };
  P.key = function(k){
    if (P.busy || P.lockedNow() > 0) return;
    if (k === 'back') P.value = P.value.slice(0, -1);
    else if (P.value.length < 4) P.value += k;
    P.draw();
    P.error('');
    if (P.value.length === 4) {
      P.busy = true;
      Promise.resolve(c.onDone(P.value)).catch(function(){}).then(function(){ P.busy = false; });
    }
  };
  return P;
}
// Verifies a PIN against the stored passcode and paints the right message on the pad. true = correct.
async function pcAttempt(pad, pin){
  const r = await pcCheck(pin);
  if (r.status === 'ok') return true;
  pad.reset();
  if (r.status === 'blocked') { pad.error(''); pad.showLock(r.ms); }
  else pad.error(r.left === 1 ? '1 attempt left' : 'Try again');
  return false;
}

