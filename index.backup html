function fmtDate(iso){
  if (!iso) return '-';
  try {
    const d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    return d.toLocaleString('en-NG', { dateStyle: 'medium', timeStyle: 'short' });
  } catch (e) { return String(iso); }
