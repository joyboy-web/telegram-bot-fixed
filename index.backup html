  if (u) return u > Date.now();            // an expired boost is never shown
  return !!(p.boosted || p.is_boosted);
}
function boostText(untilMs){
  const ms = Math.max(0, untilMs - Date.now());
  const h = Math.floor(ms / 3600000);
