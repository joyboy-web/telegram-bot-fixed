/* ----- deep link: prod_ / ref_ / inv_ from start_param (startapp) ----- */
function getStartParam(){
  const ok = function(v){ return (typeof v === 'string' && /^[A-Za-z0-9_-]{1,64}$/.test(v)) ? v : ''; };
  let v = '';
  try { v = ok(tg && tg.initDataUnsafe && tg.initDataUnsafe.start_param); } catch (e) {}   // 1. initDataUnsafe.start_param
  if (v) return v;
  try { if (tg && tg.initData) v = ok(new URLSearchParams(tg.initData).get('start_param')); } catch (e) {}  // 2. initData start_param
  if (v) return v;
  try {                                                                                      // 3. URL ?startapp= / ?start=
    const q = new URLSearchParams(window.location.search || '');
    v = ok(q.get('startapp')) || ok(q.get('start')) || ok(q.get('tgWebAppStartParam'));
  } catch (e) {}
  if (v) return v;
  try { v = ok(new URLSearchParams((window.location.hash || '').replace(/^#/, '')).get('tgWebAppStartParam')); } catch (e) {}
  return v;
}
async function handleDeepLink(){
  const sp = getStartParam();
  if (!sp) return;

  const mRef = /^(?:ref|inv)_(\d{1,15})$/.exec(sp);
  if (mRef) {
    if (!referralNoted) {
      referralNoted = true;
      if (String(mRef[1]) === String(state.telegram_id)) showToast('You cannot use your own referral link');
      else showToast('Referral accepted');
    }
    return;
  }

  if (sp.indexOf('prod_') !== 0) return;
  const code = sp.slice(5);
  if (!code) return;
  const match = function(p){ return String(p.id) === code || prodCode(p) === code; };
  let prod = null;
  try {
    const r = await api('/api/products?code=' + encodeURIComponent(code));
    if (r.res.ok) {
      const d = r.data;
      prod = d.product || (Array.isArray(d.products) ? (d.products.filter(match)[0] || null) : null);
    }
  } catch (e) {}
  if (!prod) {
    try {
      const r2 = await api('/api/products/' + encodeURIComponent(code));
      if (r2.res.ok) prod = r2.data.product || (r2.data.id ? r2.data : null);
    } catch (e) {}
  }
  if (!prod) { showToast('Product not found'); return; }
  openProductPreview(prod);
}

