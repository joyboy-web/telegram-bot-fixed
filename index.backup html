const wh = { logs: [], f: 'all', q: '', date: '' };
function whFail(l){ return l.success === false || /fail|error|declin|revert/i.test(String(l.status || '')); }
function whAmount(l){
  const k = (l.amount_kobo !== undefined && l.amount_kobo !== null) ? l.amount_kobo : l.amount;
  return (k === undefined || k === null) ? '-' : nairaFmt(k);
}
function whRow(l){
  const item = el('div', 'item tap');
  const mid = el('div', 'mid');
  mid.appendChild(el('div', 't', String(l.reference || '-')));
  mid.appendChild(el('div', 's', fmtDate(l.created_at) + ' · ' + String(l.event || '-')));
  item.appendChild(mid);
  const right = el('div');
  right.style.textAlign = 'right';
  right.appendChild(el('div', 'amt', whAmount(l)));
  right.appendChild(el('span', 'badge ' + (whFail(l) ? 'b-fail' : 'b-ok'), whFail(l) ? 'Failed' : 'Success'));
  item.appendChild(right);
  item.addEventListener('click', function(){ openWhDetail(l); });
  return item;
}
function whRender(){
  const fb = $('wh-failed'), fe = $('wh-failed-empty'), list = $('wh-list'), empty = $('wh-empty');
  clearNode(fb); clearNode(list);
  const sorted = wh.logs.slice().sort(function(a, b){ return (Date.parse(b.created_at) || 0) - (Date.parse(a.created_at) || 0); });
  const failed = sorted.filter(whFail).slice(0, 20);            // failed transactions first, no scrolling
  fe.style.display = failed.length ? 'none' : 'block';
  failed.forEach(function(l){ fb.appendChild(whRow(l)); });
  const q = wh.q.trim().toLowerCase();
  const rows = sorted.filter(function(l){
    if (wh.f === 'success' && whFail(l)) return false;
    if (wh.f === 'failed' && !whFail(l)) return false;
    if (wh.f === 'date' && wh.date) {
      const d = new Date(l.created_at);
      if (isNaN(d.getTime()) || d.toLocaleDateString('en-CA') !== wh.date) return false;
    }
    if (q && String(l.reference || '').toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  empty.style.display = rows.length ? 'none' : 'block';
  rows.forEach(function(l){ list.appendChild(whRow(l)); });
}
async function b7WhLoad(){
  $('wh-denied').style.display = 'none';
  $('wh-body').style.display = '';
  $('wh-empty').textContent = 'No logs';
  let r;
  try { r = await api('/api/admin/webhook-logs', { headers: getAuthHeader() }); }
  catch (e) { showToast('Network error. Try again.'); return; }
  if (r.res.status === 403) {                                   // not an admin: Access Denied, no data
    wh.logs = [];
    $('wh-body').style.display = 'none';
    $('wh-denied').style.display = 'block';
    return;
  }
  if ([404, 405, 501].indexOf(r.res.status) >= 0) {
    wh.logs = []; whRender();
    $('wh-empty').textContent = 'Coming in backend update';
    return;
  }
  wh.logs = (r.res.ok && Array.isArray(r.data.logs)) ? r.data.logs : [];
  whRender();
}
function openWhDetail(l){
  const failed = whFail(l);
  $('whd-ref').textContent = String(l.reference || '-');
  $('whd-event').textContent = String(l.event || '-');
