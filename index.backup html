function b7RenderChatList(){
  const box = $('chat-list');
  if (!box) return;
  clearNode(box);
  const rows = [];
  const exp = b7ExpiryMs();
  const botProducts = {};
  const keys = [];
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf('paylock_chat_') === 0) keys.push(k);
    }
  } catch (e) {}
  keys.forEach(function(k){
    let s = null;
    try { s = JSON.parse(localStorage.getItem(k)); } catch (e) { s = null; }
    if (!s || !s.product || !Array.isArray(s.messages) || !s.messages.length) return;
    const p = s.product;
    if (isOwnProduct(p)) return;
    const id = String(p.id);
    const n = s.messages.length;
    let m = getChatMeta(id);
    if (!m) { m = { len: n, seen: n, ts: Date.now() }; setChatMeta(id, m); }
    else if (m.len !== n) { m.len = n; m.ts = Date.now(); setChatMeta(id, m); }
    botProducts[id] = true;
    if (Date.now() - m.ts > exp) return;                  // expired chats leave the buyer's list automatically
    let unread = 0;
    for (let j = Math.min(m.seen, n); j < n; j++) { if (s.messages[j] && s.messages[j].role !== 'user') unread++; }
    const last = s.messages[n - 1];
    rows.push({
      name: 'PayLock Bot', av: { type: 'blank' }, ts: m.ts, unread: unread,
      preview: (p.title || p.name || p.product_name || 'Product') + ': ' + (last && last.text ? last.text : ''),
      open: function(){ enterChatRoom(); openChat(p); }
    });
  });
  (b7.orders || []).forEach(function(o){
    const isSeller = String(o.seller_id) === String(state.telegram_id);
    if (!isSeller && botProducts[String(o.product_id)]) return;   // buyer side is already covered by the PayLock Bot room
    const ts = Date.parse(o.last_message_at || o.updated_at || o.created_at) || 0;
    if (!isSeller && ts && Date.now() - ts > exp) return;
    const seen = b7Load('seen_' + o.id, '');
    const unread = (Number(o.unread_count) > 0 && String(o.last_message_at || '') !== String(seen)) ? Number(o.unread_count) : 0;
    const nm = String(o.product_name || 'Order');
    rows.push({
      name: nm, av: { type: 'init', text: nm.charAt(0).toUpperCase() }, ts: ts, unread: unread,
      preview: o.last_message || ((isSeller ? 'You are selling' : 'You are buying') + ' · ' + String(o.status || '')),
      open: function(){ b7Save('seen_' + o.id, String(o.last_message_at || '')); openOrderChat(o); }
    });
  });
  // Support Chat row (blank circle). Admin replies are read from the ticket data and shown in the thread.
  const t0 = (supportState.tickets && supportState.tickets[0]) || null;
  let sPrev = 'Tap to contact support', sTs = 0, sUnread = 0;
  if (t0) {
    const reply = (typeof t0.reply === 'string' && t0.reply) || (typeof t0.admin_reply === 'string' && t0.admin_reply) || (typeof t0.response === 'string' && t0.response) || '';
    sPrev = reply || String(t0.message || sPrev);
    sTs = Date.parse(t0.reply_created_at || t0.updated_at || t0.created_at) || 0;
    if (reply && sTs > Number(b7Load('support_seen', 0))) sUnread = 1;
  }
  rows.push({ name: 'Support Chat', av: { type: 'blank' }, ts: sTs, unread: sUnread, preview: sPrev,
    tick: (t0 && !(t0.reply || t0.admin_reply || t0.response)) ? supTick(t0.status) : null,
    open: function(){ b7Save('support_seen', Date.now()); goSupport(); } });
  rows.sort(function(a, b){ return b.ts - a.ts; });       // last_message_at DESC: newest on top
  rows.forEach(function(r){ box.appendChild(b7ChatRow(r)); });
}
