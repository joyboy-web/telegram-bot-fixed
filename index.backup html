/* ----- 4. Delete: two confirmations, then the real route ----- */
function sxDelBuild(){
  const d = sx.del;
  if (d.box) return;
  const ov = el('div', 'overlay center');
  ov.id = 'sx-del-overlay';
  const card = el('div', 'tcard');
  card.setAttribute('role', 'dialog');
  card.style.textAlign = 'center';
  const ic = el('div', 'tic');
  ic.appendChild(svgIcon(SX_TRASH, 26));
  card.appendChild(ic);
  d.title = el('h3', null, 'Delete Product');
  d.msg = el('p', null, '');
  d.msg.style.margin = '0 0 8px';
  d.name = el('p', 'small muted', '');
  d.name.style.cssText = 'margin-bottom:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
  const row = el('div', 'btn-row');
  d.cancel = el('button', 'btn secondary', 'Cancel');
  d.cancel.type = 'button';
  d.ok = el('button', 'btn', 'Delete');
  d.ok.type = 'button';
  d.ok.style.fontSize = '14px';
  d.cancel.addEventListener('click', function(){ if (!d.busy) sxDelClose(); });
  d.ok.addEventListener('click', sxDelNext);
  ov.addEventListener('click', function(ev){ if (ev.target === ov && !d.busy) sxDelClose(); });
  row.appendChild(d.cancel);
  row.appendChild(d.ok);
  card.appendChild(d.title);
  card.appendChild(d.msg);
  card.appendChild(d.name);
  card.appendChild(row);
  ov.appendChild(card);
  document.body.appendChild(ov);
  d.box = ov;
}
function sxDelStart(p){
  sxDelBuild();
  const d = sx.del;
  d.p = p;
  d.step = 1;
  d.busy = false;
  d.title.textContent = 'Delete Product';
  d.msg.textContent = 'Are you sure you want to delete this product?';
  d.name.textContent = String(p.name || p.title || 'Untitled');
  d.ok.textContent = 'Delete';
  d.box.classList.add('open');
}
function sxDelClose(){
  const d = sx.del;
  if (!d.box) return;
  d.box.classList.remove('open');
  d.p = null;
  d.step = 0;
  d.busy = false;
}
function sxDelNext(){
  const d = sx.del;
  if (d.busy || !d.p) return;
  if (d.step === 1) {                                      // 1st confirm accepted: show the 2nd
    d.step = 2;
    d.title.textContent = 'Delete Permanently';
    d.msg.textContent = 'This will permanently delete this product. This cannot be undone.';
    d.ok.textContent = 'Yes, Delete Permanently';
    return;
  }
  sxDelRun();                                              // only the 2nd confirm reaches the route
}
async function sxDelRun(){
  const d = sx.del, p = d.p;
  if (!p || d.step !== 2 || d.busy) return;
  d.busy = true;
  const done = setBusy(d.ok, 'Deleting...');
  // DELETE /api/products/<id> is MISSING in BASE. postApi shows "Coming in backend update" on 404/405/501 and the server error otherwise.
  const r = await postApi('/api/products/' + encodeURIComponent(p.id), {}, false, 'DELETE');
  done();
  d.busy = false;
  if (r && r.ok) {
    const id = String(p.id);
    state.products = state.products.filter(function(x){ return String(x.id) !== id; });
    state.myProducts = (state.myProducts || []).filter(function(x){ return String(x.id) !== id; });
    sxDelClose();
    showToast('Product deleted');
    b7LoadSell();                                          // Sell page
    loadProducts();                                        // Marketplace
  } else {
    sxDelClose();                                          // route missing or refused: nothing is removed from the UI
  }
}

/* ----- Sell page list (replaces the b7LoadSell binding; the Part 2 function stays in the file, unedited and unused) -----
   OLD filter (Part 2): rows.filter(function(p){ return pVisible(p) && !p.deleted_at; })
   NEW filter: rows.filter(function(p){ return !p.deleted_at; })  -> a hidden product stays in My Active Listings with a Hidden badge */
b7LoadSell = async function(){
  const token = ++sx.seq;
  const grid = $('sell-listings'), empty = $('sell-empty');
  let rows = [];
  try {
    const r = await api('/api/products?mine=1', { headers: getAuthHeader() });
    rows = (r.res.ok && Array.isArray(r.data.products)) ? r.data.products : [];
  } catch (e) { rows = []; }
  rows = rows.filter(isOwnProduct);
  if (!rows.length) rows = state.products.filter(isOwnProduct);
  rows = rows.filter(function(p){ return !p.deleted_at; });
  if (token !== sx.seq) return;                            // a newer load already ran
  clearNode(grid);
  empty.style.display = rows.length ? 'none' : 'block';
  let sales = 0, views = 0;
  rows.forEach(function(p){
    const v = Number((p.views !== undefined && p.views !== null) ? p.views : (p.view_count || 0)) || 0;
    sales += pSales(p); views += v;
    const hidden = state.banned || !pVisible(p);
    const card = el('div', 'pcard');
    card.addEventListener('click', function(){ openProductPreview(p); });   // Preview Page (existing)
    if (typeof p.image_url === 'string' && p.image_url.indexOf('https://') === 0) {
      const img = document.createElement('img');
      img.className = 'pimg'; img.alt = ''; img.loading = 'lazy'; img.src = p.image_url;
      card.appendChild(img);
    }
    card.appendChild(el('div', 'ptitle', p.name || p.title || 'Untitled'));
    card.appendChild(el('div', 'pprice', nairaFmt(p.buyer_pays_kobo || p.price_kobo || 0)));
    card.appendChild(el('div', 'pc-meta', 'Views ' + v + ' · Sales ' + pSales(p)));
    if (hidden) { const w = el('div'); w.appendChild(el('span', 'badge b-hidden', 'Hidden')); card.appendChild(w); }
    sxDecorate(card, p);                                   // 3-dot button, top-right of the picture
    grid.appendChild(card);
  });
  $('sell-an-sales').textContent = String(sales);
  $('sell-an-views').textContent = String(views);
  try {
    const r2 = await api('/api/analytics', { headers: getAuthHeader() });
    const d = r2.res.ok ? (r2.data.analytics || r2.data || {}) : {};
    $('sell-an-revenue').textContent = nairaFmt(d.total_revenue_kobo || 0);
  } catch (e) {}
};
/* ===== PATCH: support bubbles, avatars, profile sheet, CSV, boost UI ===== */
function supTime(ts){
  const d = new Date(ts);
  return isNaN(d.getTime()) ? '' : d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
}
// Pending = clock, Sent = single tick, Delivered = double grey, Read = double gold. The word "pending" is never shown.
function supTick(status){
  const s = String(status || '').toLowerCase();
  if (/read|resolved|closed|answered|replied/.test(s)) return 'read';
  if (/deliver|open|seen|progress/.test(s)) return 'delivered';
  if (/sent/.test(s)) return 'sent';
  return 'pending';
}
function supTickEl(kind){
  const dbl = (kind === 'delivered' || kind === 'read');
  const s = b7Svg('svg', { viewBox: dbl ? '0 0 18 12' : '0 0 12 12', width: dbl ? '18' : '12', height: '12', fill: 'none',
    stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' });
  s.setAttribute('class', 'sup-tick' + (kind === 'read' ? ' read' : ''));
  if (kind === 'pending') {
    s.appendChild(b7Svg('circle', { cx: '6', cy: '6', r: '4.8' }));
    s.appendChild(b7Svg('path', { d: 'M6 3.5V6l1.8 1.1' }));
  } else {
    s.appendChild(b7Svg('path', { d: 'M2 6.5L5 9.5L10 2.5' }));
    if (dbl) s.appendChild(b7Svg('path', { d: 'M7 6.5L10 9.5L15 2.5' }));
  }
  return s;
}
function fxAv(kind, size, text){
