/* ----- sales metrics, links ----- */
function pSales(p){
  const v = (p.sales_count !== undefined && p.sales_count !== null) ? p.sales_count : (p.sales || p.sold_count || 0);
  const n = Number(v);
  return (isFinite(n) && n > 0) ? n : 0;
}
function pRating(p){
  const v = (p.avg_rating !== undefined && p.avg_rating !== null) ? p.avg_rating : (p.rating || p.rating_avg || 0);
  const n = Number(v);
  return (isFinite(n) && n > 0) ? n : 0;
}
function salesLine(p){
  const n = pSales(p);
  if (!n) return 'New • 0 sales';
  const r = pRating(p);
  return n.toLocaleString('en-US') + ' sales • ' + (r ? r.toFixed(1) + '/5' : 'no rating');
}
function prodCode(p){ return String(p.short_code || p.code || p.link_code || p.id); }
function productLink(p){ return 'https://t.me/' + CONFIG.BOT_USERNAME + '?start=prod_' + prodCode(p); }
async function copyText(text, okMsg){
  let ok = false;
  try { if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); ok = true; } } catch (e) {}
  if (!ok) {
    try {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      ok = document.execCommand('copy');
      document.body.removeChild(ta);
    } catch (e) { ok = false; }
  }
  showToast(ok ? okMsg : 'Could not copy link');
}
function copyLink(p){ return copyText(productLink(p), 'Link copied'); }

