/* ----- marketplace search + filter (in-memory) ----- */
function renderMkChips(){
  const cats = ['All'];
  state.products.forEach(function(p){ if (p.category && cats.indexOf(p.category) < 0) cats.push(p.category); });
  const cbox = $('mk-cats'), sbox = $('mk-sort');
  if (!cbox || !sbox) return;
  clearNode(cbox);
  clearNode(sbox);
  cats.forEach(function(c){
    const b = el('button', 'chip' + (mk.cat === c ? ' active' : ''), c);
    b.type = 'button';
    b.addEventListener('click', function(){ mk.cat = c; applyBuyFilter(); });
    cbox.appendChild(b);
  });
  [['new', 'Newest'], ['low', 'Price: Low to High'], ['high', 'Price: High to Low']].forEach(function(s){
    const b = el('button', 'chip' + (mk.sort === s[0] ? ' active' : ''), s[1]);
    b.type = 'button';
    b.addEventListener('click', function(){ mk.sort = s[0]; applyBuyFilter(); });
    sbox.appendChild(b);
  });
}
function applyBuyFilter(){
  renderMkChips();
  let list = state.products.slice();
  const q = mk.q.trim().toLowerCase();
  if (mk.cat !== 'All') list = list.filter(function(p){ return p.category === mk.cat; });
  if (q) list = list.filter(function(p){
    return [p.name, p.title, p.description, p.category].join(' ').toLowerCase().indexOf(q) >= 0;
  });
  if (mk.sort === 'low') list.sort(function(a, b){ return (a.buyer_pays_kobo || 0) - (b.buyer_pays_kobo || 0); });
  else if (mk.sort === 'high') list.sort(function(a, b){ return (b.buyer_pays_kobo || 0) - (a.buyer_pays_kobo || 0); });
  else list.sort(function(a, b){ return (Date.parse(b.created_at) || 0) - (Date.parse(a.created_at) || 0); });
  renderProductGrid('buy-grid', 'buy-empty', list);
}

