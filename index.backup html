// Black (light) / white (dark) line = high, grey = low (colours come from CSS variables)
function b7Graph(pts){
  const svg = $('an-graph'), empty = $('an-empty');
  clearNode(svg);
  if (!pts.length) { svg.style.display = 'none'; empty.style.display = 'block'; return; }
  svg.style.display = ''; empty.style.display = 'none';
  const W = 320, H = 180, P = 24;
  const vals = pts.map(function(p){ return Number(p.v) || 0; });
  const max = Math.max.apply(null, vals.concat([1]));
  const avg = vals.reduce(function(a, b){ return a + b; }, 0) / vals.length;
  const X = function(i){ return pts.length === 1 ? W / 2 : P + i * (W - 2 * P) / (pts.length - 1); };
  const Y = function(v){ return H - P - (v / max) * (H - 2 * P); };
  svg.appendChild(b7Svg('line', { x1: P, y1: H - P, x2: W - P, y2: H - P, 'class': 'g-axis' }));
  if (pts.length === 1) {
    svg.appendChild(b7Svg('circle', { cx: X(0), cy: Y(vals[0]), r: 4, fill: 'var(--g-hi)' }));
  }
  for (let i = 1; i < pts.length; i++) {
    const hi = (vals[i - 1] + vals[i]) / 2 >= avg;
    svg.appendChild(b7Svg('path', { d: 'M' + X(i - 1) + ' ' + Y(vals[i - 1]) + ' L' + X(i) + ' ' + Y(vals[i]), 'class': hi ? 'g-hi' : 'g-lo' }));
  }
  const t1 = b7Svg('text', { x: P, y: H - 6, 'class': 'g-txt' }); t1.textContent = String(pts[0].t || '');
  const t2 = b7Svg('text', { x: W - P, y: H - 6, 'class': 'g-txt', 'text-anchor': 'end' }); t2.textContent = String(pts[pts.length - 1].t || '');
  const t3 = b7Svg('text', { x: P, y: 12, 'class': 'g-txt' }); t3.textContent = String(max);
  svg.appendChild(t1); svg.appendChild(t2); svg.appendChild(t3);
}

