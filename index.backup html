/* ---------- Boot ---------- */
// Gates show ONLY while booting or on a real failure. A boot can never hang: the verify call has a 15s limit.
async function boot(){
  if (bootBusy) return;
  bootBusy = true;
  try {
    showGate('loading');
    if (!tg || !tg.initData) { showGate('blocked'); return; }
    if (!navigator.onLine) { showGate('offline'); return; }
    const initData = tg.initData;
    let r;
    try {
      r = await withTimeout(api('/api/auth/validate', {
        method: 'POST', headers: jsonHeaders(),
        body: JSON.stringify({ init_data: initData, initData: initData })
      }), 15000);
    } catch (e) {
      showGate(navigator.onLine ? 'error' : 'offline');
      return;
    }
    if (r.res.status === 403 && r.data.code === 'ACCOUNT_DELETED') { showDeletedGate(); return; }
    if (!r.res.ok || !r.data.user) { showGate('error'); return; }
    const u = r.data.user;
    state.telegram_id = u.telegram_id;
    state.first_name = u.first_name || '';
    $('home-greeting').textContent = 'Hi ' + (state.first_name || 'there');
    $('home-id').textContent = 'ID: ' + u.telegram_id;
    state.banned = !!(u.banned || u.is_banned || u.status === 'banned');
    booted = true;
    hideGates();                       // the app and the tabbar are reachable from here on
    try { renderBanBanner(); } catch (e) {}
    loadBalanceVisibility();
    updateEyeIcon();
    renderBalance();
    loadProducts();
    loadBalance();
    loadEscrowOrders();
    handleDeepLink().catch(function(){ /* never blocks the app */ });
  } catch (e) {
    showGate(navigator.onLine ? 'error' : 'offline');
  } finally {
    bootBusy = false;
  }
}

/* ===================== CHAT ===================== */
const chatState = {
  product:null, messages:[], stage:'ask', orderId:null, busy:false,
  waitingComplaint:false, waitingOrderId:null, pendingStars:0, complaintText:null, ratingBusy:false,
  remote:[], remoteSig:'', remoteOff:false
};

function chatPush(role, text){
  chatState.messages.push({ role: role, text: String(text) });
  renderChatMessages();
}

async function chatFetchOrders(){
  try {
    const r = await api('/api/escrow/list', { headers: getAuthHeader() });
    return (r.res.ok && Array.isArray(r.data.orders)) ? r.data.orders : [];
  } catch(e){ return []; }
}

function chatResetRemote(){
  chatState.remote = [];
  chatState.remoteSig = '';
  chatState.remoteOff = false;
}

function openChat(product){
  // product == null: no message pushed, no state reset, just render + navigate
  if(!product){ renderChatMessages(); goPage('pg-chat'); return; }

  // seller never enters the buy flow: send to product preview instead
  const sellerId0 = (product.seller_id !== undefined && product.seller_id !== null) ? product.seller_id : product.owner_id;
  if(sellerId0 !== undefined && sellerId0 !== null && state.telegram_id !== undefined && state.telegram_id !== null
     && String(sellerId0) === String(state.telegram_id)){
    openProductPreview(product);
    return;
  }

  // same product with messages already in memory: do not reset
  if(chatState.product && String(chatState.product.id)===String(product.id) && chatState.messages.length>0){
    renderChatMessages(); goPage('pg-chat'); chatLoadRemote(); return;
  }

  // nothing in memory for this product, try localStorage first
  let saved = null;
  try {
    const raw = localStorage.getItem('paylock_chat_' + product.id);
    if(raw) saved = JSON.parse(raw);
  } catch(e){ saved = null; }

  if(saved && Array.isArray(saved.messages)){
    const okRoles = { paylock:1, user:1, system:1 };
    const okStages = { ask:1, paid:1, done:1, seller:1 };
    const msgs = saved.messages.filter(function(m){
      return m && okRoles[m.role] && typeof m.text === 'string';
    });
    if(msgs.length > 0){
      chatState.product = product;
      chatState.messages = msgs;
      chatState.stage = okStages[saved.stage] ? saved.stage : 'ask';
      chatState.orderId = (saved.orderId !== undefined) ? saved.orderId : null;
      chatState.busy = false;
      chatResetRemote();
      renderChatMessages(); goPage('pg-chat'); chatLoadRemote(); return;
    }
  }

  // fresh chat
  chatState.product = product;
  chatState.messages = [];
  chatState.stage = 'ask';
  chatState.orderId = null;
  chatState.busy = false;
  chatResetRemote();

  chatPush('paylock', "Do you want to continue the purchase of this product? Reply with 'yes' to continue.");
  renderChatMessages();
  goPage('pg-chat');
}

// Opens the real buyer <-> seller room of an order (used by the Seller ID list and the escrow card).
function openOrderChat(o){
  if(!o) return;
  const isSeller = String(o.seller_id) === String(state.telegram_id);
  let saved = null;
  try {
    const raw = localStorage.getItem('paylock_chat_' + o.product_id);
    if(raw) saved = JSON.parse(raw);
  } catch(e){ saved = null; }
  const sameOrder = !!(saved && String(saved.orderId) === String(o.id));
  let p = (sameOrder && saved.product) ? saved.product : null;
  if(!p){
    p = { id:o.product_id, name:o.product_name || 'Order', title:o.product_name || 'Order',
          seller_id:o.seller_id, buyer_pays_kobo:o.buyer_pays_kobo, price_kobo:o.price_kobo };
  }
  const okRoles = { paylock:1, user:1, system:1 };
  chatState.product = p;
  chatState.orderId = o.id;
  chatState.busy = false;
  chatState.stage = (String(o.status) === 'held') ? 'paid' : 'done';
  chatState.messages = (!isSeller && sameOrder && Array.isArray(saved.messages))
    ? saved.messages.filter(function(m){ return m && okRoles[m.role] && typeof m.text === 'string'; })
    : [];
  if(!chatState.messages.length){
    chatState.messages.push({ role:'system', text: isSeller ? 'Chat with the buyer about this order.' : 'Chat with the seller about this order.' });
  }
  chatResetRemote();
  enterChatRoom();
  renderChatMessages();
  goPage('pg-chat');
  chatLoadRemote();
}

function renderChatMessages(){
  const emptyEl = document.getElementById('chat-empty');
  const rootEl = document.getElementById('chat-root');
  if(!chatState.product){
    if(emptyEl) emptyEl.style.display = '';
    if(rootEl) rootEl.style.display = 'none';
    return;
  }
  if(emptyEl) emptyEl.style.display = 'none';
  if(rootEl) rootEl.style.display = '';

  const p = chatState.product;
  const own = isOwnProduct(p);
  const card = document.getElementById('chat-product');
  while(card.firstChild) card.removeChild(card.firstChild);
  const nameEl = document.createElement('div');
  nameEl.style.fontWeight = '700';
  nameEl.textContent = p.title || p.name || p.product_name || 'Product';
  const priceEl = document.createElement('div');
  priceEl.style.color = 'var(--muted)';
  priceEl.textContent = nairaFmt(p.buyer_pays_kobo || p.price_kobo || 0);
  card.appendChild(nameEl);
  card.appendChild(priceEl);

  const box = document.getElementById('chat-messages');
  while(box.firstChild) box.removeChild(box.firstChild);
  chatState.messages.forEach(function(m){
    const d = document.createElement('div');
    d.className = 'chat-msg chat-msg-' + m.role;
    if (m.role === 'paylock') {
      const lb = document.createElement('div');
      lb.className = 'chat-msg-label';
      lb.appendChild(document.createTextNode('PayLock '));
      const tk = document.createElement('span');
      tk.className = 'chat-tick';
      tk.appendChild(checkIcon(9));
      lb.appendChild(tk);
      d.appendChild(lb);
      d.appendChild(document.createTextNode(m.text));
    } else {
      d.textContent = m.text;
    }
    box.appendChild(d);
  });
  // real seller <-> buyer messages from the API
  chatState.remote.forEach(function(m){
    const d = document.createElement('div');
    const mine = !!m.is_mine;
    d.className = 'chat-msg ' + (mine ? 'chat-msg-user' : 'chat-msg-peer');
    if (!mine) {
      const lb = document.createElement('div');
      lb.className = 'chat-msg-label';
      lb.textContent = (m.sender_role === 'seller') ? 'Seller' : 'Buyer';
      d.appendChild(lb);
    }
    d.appendChild(document.createTextNode(String(m.text || '')));
    box.appendChild(d);
  });

  document.getElementById('pay-in-chat').style.display = (chatState.stage === 'ask') ? '' : 'none';
  document.getElementById('chat-confirm-btn').style.display = (chatState.stage === 'paid' && !own) ? '' : 'none';
  document.getElementById('chat-dispute-btn').style.display = (chatState.stage === 'paid') ? '' : 'none';

  try { if(box.lastChild) box.lastChild.scrollIntoView({ block: 'end' }); } catch(e){}

  chatSave();
  chatPoll();
  renderRatingBox();
  chatExtrasRender();
}

function chatSave(){
  try {
    if(!chatState.product || isOwnProduct(chatState.product)) return;
    localStorage.setItem('paylock_chat_' + chatState.product.id, JSON.stringify({
      product: chatState.product,
      messages: chatState.messages,
      stage: chatState.stage,
      orderId: chatState.orderId
    }));
  } catch(e){}
}

/* Real messages: GET /api/chat/<order_id>. 501 / 404 -> localStorage fallback; 403 -> not a party. */
async function chatLoadRemote(){
  const oid = chatState.orderId;
  if(!oid || chatState.remoteOff) return;
  try {
    const r = await api('/api/chat/' + encodeURIComponent(oid), { headers: getAuthHeader() });
    if(String(chatState.orderId) !== String(oid)) return;
    if(r.res.status === 501 || r.res.status === 404){ chatState.remoteOff = true; return; }
    if(r.res.status === 403){ chatState.remoteOff = true; showToast('Chat is only for the buyer and seller of this order'); return; }
    if(!r.res.ok) return;
    const rows = Array.isArray(r.data.messages) ? r.data.messages : [];
    const last = rows.length ? rows[rows.length - 1] : null;
    const sig = rows.length + ':' + (last ? String(last.id || last.created_at || '') : '');
    if(sig === chatState.remoteSig) return;
    chatState.remoteSig = sig;
    chatState.remote = rows;
    renderChatMessages();
  } catch(e){ /* silent: next poll retries */ }
}

async function chatSendRemote(text){
  const input = document.getElementById('chat-input');
  try {
    const r = await api('/api/chat/send', {
      method: 'POST', headers: jsonHeaders(),
      body: JSON.stringify({ order_id: chatState.orderId, text: text })
    });
    if(r.res.ok){ chatLoadRemote(); return; }
    if(r.res.status === 501 || r.res.status === 404){
      chatState.remoteOff = true;          // table not ready: keep the message locally
      chatPush('user', text);
      return;
    }
    if(r.res.status === 403) showToast('Chat is only for the buyer and seller of this order');
    else showToast(r.data.error || 'Message not sent');
  } catch(e){
    showToast('Network error. Try again.');
  }
  if(input && !input.value) input.value = text;   // give the text back so nothing is lost
}

let chatPollTimer = null;

function chatPoll(){
  const needed = !!(chatState.product && chatState.orderId && chatMode === 'room');
  if(!needed){
    if(chatPollTimer){ clearInterval(chatPollTimer); chatPollTimer = null; }
    return;
  }
  if(chatPollTimer) return;

  chatPollTimer = setInterval(async function(){
    const pg = document.getElementById('pg-chat');
    if(!pg || !pg.classList.contains('active') || chatMode !== 'room' || !chatState.orderId){
      clearInterval(chatPollTimer); chatPollTimer = null; return;
    }
    chatLoadRemote();                      // every 10s while the room is open
    if(chatState.busy || chatState.stage === 'done') return;

    const watchedId = chatState.orderId;
    const list = await chatFetchOrders();

    if(chatState.busy || chatState.stage === 'done' || String(chatState.orderId) !== String(watchedId)) return;

    const o = list.filter(function(x){ return String(x.id) === String(watchedId); })[0];
    if(!o) return;

    if(o.status === 'released'){
      chatState.stage = 'done';
      chatPush('system', "Seller has been paid");
      renderChatMessages();
    } else if(o.status === 'disputed'){
      chatState.stage = 'done';
      chatPush('system', "Dispute opened - escrow frozen");
      renderChatMessages();
    }
  }, 10000);
}

/* ===================== BLOCK E - RATING ALONE ===================== */
const ratingReleased = {};   // orderId -> true/false (cache of the "is released" check)
const ratingChecking = {};   // orderId -> true while a check is in flight
let ratingWired = false;

// private helper: fill SVG stars up to n
const ratingFill = function(n){
  const btns = document.querySelectorAll('#rate-stars .rate-star');
  btns.forEach(function(b, i){ b.classList.toggle('on', i < n); });
};

function renderRatingBox(){
  const box = document.getElementById('ratingBox');
  if(!box) return;
  const label = document.getElementById('rating-label');
  const wrap = document.getElementById('rate-stars');
  const p = chatState.product;
  box.style.display = 'none';

  // only: a product, an order, stage 'paid' (delivered) or 'done'
  if(!p || !chatState.orderId || (chatState.stage !== 'done' && chatState.stage !== 'paid')) return;

  // buyer only
  const sid = (p.seller_id !== undefined && p.seller_id !== null) ? p.seller_id : p.owner_id;
  const isSeller = (sid !== undefined && sid !== null && state.telegram_id !== undefined && state.telegram_id !== null)
                   && String(sid) === String(state.telegram_id);
  if(isSeller) return;

  // only when the order is 'released' (stage 'done' is also used for disputed)
  const oid = String(chatState.orderId);
  if(chatState.stage !== 'paid' && ratingReleased[oid] !== true){
    if(ratingReleased[oid] === undefined && !ratingChecking[oid]){
      ratingChecking[oid] = true;
      chatFetchOrders().then(function(list){
        ratingChecking[oid] = false;
        if(!list || list.length === 0) return;   // network blip: retry on a later render, no loop
        const o = list.filter(function(x){ return String(x.id) === oid; })[0];
        ratingReleased[oid] = !!(o && o.status === 'released');
        renderRatingBox();
      }).catch(function(){ ratingChecking[oid] = false; });
    }
    return;
  }

  // wire the stars once
  if(!ratingWired){
    ratingWired = true;
    wrap.querySelectorAll('.rate-star').forEach(function(b, i){
      const n = i + 1;
      b.addEventListener('mouseover', function(){ if(!b.disabled) ratingFill(n); });
      b.addEventListener('mouseout', function(){
        if(!b.disabled) ratingFill(chatState.waitingComplaint ? (chatState.pendingStars || 0) : 0);
      });
      b.addEventListener('click', function(){
        if(b.disabled) return;
        ratingFill(n);
        wrap.querySelectorAll('.rate-star').forEach(function(x){ x.disabled = true; });
        submitRating(n);
      });
    });
  }

  box.style.display = '';

  // already rated: text only, no stars
  let rated = null, complaintSaved = false;
  try {
    rated = localStorage.getItem('rated_' + oid);
    complaintSaved = localStorage.getItem('rated_complaint_' + oid) === '1';
  } catch(e){}
  if(rated){
    const n = Math.max(1, Math.min(5, parseInt(rated, 10) || 1));
    label.textContent = 'You rated ' + n + ' out of 5' + (complaintSaved ? ' + complaint saved' : '');
    wrap.style.display = 'none';
    return;
  }

  label.textContent = 'Rate this seller:';
  wrap.style.display = '';

  // restore a pending complaint after reload (chatSave does not store it)
  let pending = null;
  try { pending = localStorage.getItem('rate_pending_' + oid); } catch(e){}
  if(pending && !(chatState.waitingComplaint && String(chatState.waitingOrderId) === oid)){
    chatState.waitingComplaint = true;
    chatState.waitingOrderId = oid;
    chatState.pendingStars = parseInt(pending, 10) || 1;
  }
  const waiting = !!(chatState.waitingComplaint && String(chatState.waitingOrderId) === oid);
  wrap.querySelectorAll('.rate-star').forEach(function(b){ b.disabled = waiting || !!chatState.ratingBusy || !!chatState.refundPrompt; });
  ratingFill(waiting ? (chatState.pendingStars || 0) : 0);
}

async function submitRating(stars){
  const p = chatState.product, oid = chatState.orderId;
  if(!p || !oid || chatState.ratingBusy) return;
  stars = Math.round(Number(stars));
  if(!(stars >= 1 && stars <= 5)) return;
  if(chatState.stage === 'paid') return rateInEscrow(stars);

  // BAD (1-2): ask for the complaint first, send only after it is typed
  let complaint = null;
  if(stars <= 2){
    if(chatState.complaintText){
      complaint = String(chatState.complaintText).slice(0, 500);
    } else {
      chatState.waitingComplaint = true;
      chatState.waitingOrderId = oid;
      chatState.pendingStars = stars;
      try { localStorage.setItem('rate_pending_' + oid, String(stars)); } catch(e){}
      chatPush('system', "Sorry about that. What went wrong? Type your complaint here.");
      chatSave();
      renderChatMessages();
      return;
    }
  }

  chatState.ratingBusy = true;
  let failed = false;
  try {
    const sellerId = p.seller_id !== undefined ? p.seller_id : p.owner_id;
    const r = await api('/api/rate', {
      method: 'POST',
      headers: jsonHeaders(),
      body: JSON.stringify({
        order_id: oid,
        product_id: p.id,
        buyer_id: state.telegram_id,
        seller_id: sellerId,
        stars: stars,
        complaint_text: complaint
      })
    });
    const data = (r && r.data) ? r.data : {};
    const code = (r && r.res) ? r.res.status : 0;
    const already = code === 409 || data.already_rated === true || data.error === 'already_rated' ||
                    data.code === 'already_rated' || data.status === 'already_rated';

    if(already){
      // show the saved rating, no stars, no question
      const saved = Number(data.stars);
      const shown = (saved >= 1 && saved <= 5) ? Math.round(saved) : stars;
      try {
        localStorage.setItem('rated_' + oid, String(shown));
        localStorage.removeItem('rate_pending_' + oid);
      } catch(e){}
      chatState.waitingComplaint = false;
    } else if(r && r.res && r.res.ok){
      try {
        localStorage.setItem('rated_' + oid, String(stars));
        localStorage.removeItem('rate_pending_' + oid);
        if(complaint) localStorage.setItem('rated_complaint_' + oid, '1');
      } catch(e){}
      chatState.waitingComplaint = false;
      if(complaint){
        chatPush('system', "Thanks, your complaint has been saved.");
      } else {
        chatPush('system', "Thanks! You rated " + stars + " out of 5");
      }
      chatSave();
    } else {
      failed = true;
    }
  } catch(e){
    failed = true;
  } finally {
    chatState.complaintText = null;   // BAD flow: buyer retypes the complaint to retry
    chatState.ratingBusy = false;
  }
  if(failed) showToast('Rating not saved, try again');
  renderChatMessages();   // also re-renders the box (re-enables stars on a 3-5 failure)
}

function handleComplaintReply(){
  if(!chatState.waitingComplaint || !chatState.orderId ||
     String(chatState.waitingOrderId) !== String(chatState.orderId)) return false;
  const input = document.getElementById('chat-input');
  if(!input) return false;
  const text = (input.value || '').trim();
  if(!text) return true;                       // swallow empty sends while waiting
  chatState.complaintText = text.slice(0, 500);   // plain text, max 500
  input.value = '';
  chatPush('user', text);
  submitRating(chatState.pendingStars);
  return true;
}
