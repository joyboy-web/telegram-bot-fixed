  [sf, sc].forEach(function(i){ i.addEventListener('change', function(){ i.value = ''; showToast('Attachments coming in backend update'); }); });
  fxSupSync();
  // transactions CSV
  $('tx-download').addEventListener('click', downloadTxCsv);
  // boost UI
  const s = b7Load('boost_ui', { days: 1, auto: false });
  fxB.days = [1, 2, 3].indexOf(Number(s.days)) >= 0 ? Number(s.days) : 1;
  fxB.auto = !!s.auto;
  $('boost-dur').querySelectorAll('button').forEach(function(b){
    b.addEventListener('click', function(){ fxB.days = Number(b.getAttribute('data-d')) || 1; b7Save('boost_ui', fxB); fxBoostRender(); });
  });
  $('boost-auto-toggle').addEventListener('click', function(){ fxB.auto = !fxB.auto; b7Save('boost_ui', fxB); fxBoostRender(); });
  try { new MutationObserver(fxBoostRender).observe($('pg-boost-terms'), { attributes: true, attributeFilter: ['class'] }); } catch (e) {}
  fxBoostRender();
}

