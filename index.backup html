const pcf = { mode: 'set', step: 'new', first: '' };
function pcfHeader(){
  const T = {
    old: ['Enter Old Passcode', 'Confirm your current passcode to continue'],
    'new': [pcf.mode === 'set' ? 'Create Passcode' : 'New Passcode', 'Enter a new 4-digit passcode'],
    confirm: ['Confirm Passcode', 'Enter the same passcode again']
  }[pcf.step];
  $('pc-title').textContent = T[0];
  $('pc-sub').textContent = T[1];
}
function b7PasscodeStart(mode){
  pcf.mode = mode; pcf.step = (mode === 'change') ? 'old' : 'new'; pcf.first = '';
  pcfHeader();
  goPage('pg-passcode');
  b7.pcPad.reset(); b7.pcPad.error('');
  if (pcf.step === 'old' && pcRemaining() > 0) b7.pcPad.showLock(pcRemaining());
}
async function pcfDone(pin){
  const pad = b7.pcPad;
  if (pcf.step === 'old') {                    // wrong old PIN uses the same 1x / 2x / block logic as login
    if (await pcAttempt(pad, pin)) { pcf.step = 'new'; pad.reset(); pad.error(''); pcfHeader(); }
    return;
  }
  if (pcf.step === 'new') { pcf.first = pin; pcf.step = 'confirm'; pad.reset(); pcfHeader(); return; }
  if (pin !== pcf.first) {
    pcf.step = 'new'; pcf.first = ''; pad.reset(); pcfHeader();
    pad.error('Pins do not match, try again');
    return;
  }
  await pcSetPin(pin);                         // new hash replaces the old one: old PIN stops working everywhere at once
  pad.reset();
  showToast(pcf.mode === 'set' ? 'Passcode Set' : 'Passcode Changed');
  b7SettingsShow();
  navBack('pg-settings');
}

