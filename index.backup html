function maybeResolveAccount(){
  clearTimeout(resolveTimer);
  resolveTimer = setTimeout(async function(){
    const acct = $('acct-number').value;
    const code = state.selectedBankCode;
    if (acct.length !== 10 || !code) return;
    try {
      const r = await api('/api/banks/resolve', {
        method: 'POST', headers: jsonHeaders(),
        body: JSON.stringify({ account_number: acct, bank_code: code })
      });
      if ($('acct-number').value !== acct || state.selectedBankCode !== code) return; // stale
      if (r.res.ok && r.data.account_name) {
        state.accountName = r.data.account_name;
        $('acct-name-text').textContent = r.data.account_name;
        $('acct-name-row').classList.add('show');
