function goFundStep(n){
  if (n === 2) {
    const email = $('fund-email').value.trim();
    if (!(state.fund.amount >= 100)) { showToast('Minimum funding amount is ₦100'); return; }
    if (!email || email.indexOf('@') < 1) { showToast('Enter a valid email'); return; }
    state.fund.email = email;
    state.fund.phone = $('fund-phone').value.trim();
    $('confirm-amount').textContent = nairaFmt(state.fund.amount * 100);
    $('confirm-email').textContent = email;
    $('pay-btn').textContent = 'Pay ' + nairaFmt(state.fund.amount * 100);
    $('pay-btn').disabled = false;
  }
  state.fund.step = n;
  $('fund-step-1').classList.toggle('show', n === 1);
  $('fund-step-2').classList.toggle('show', n === 2);
}
async function payNow(){
  const btn = $('pay-btn');
  if (btn.disabled) return;
  const amount_kobo = Math.round(state.fund.amount * 100);
  btn.disabled = true;
  const origText = btn.textContent;
  btn.textContent = 'Processing...';
  const reenable = function(){ if (fundVerifying) return; btn.disabled = false; btn.textContent = origText; };
  try {
    // Payload is ONLY {amount_kobo, email}. No card_id / save_card.
    const r = await api('/api/wallet/fund/initialize', {
      method: 'POST', headers: jsonHeaders(),
      body: JSON.stringify({ amount_kobo: amount_kobo, email: state.fund.email })
    });
    if (!r.res.ok) { showToast(r.data.error || 'Could not start payment'); reenable(); return; }
    if (typeof PaystackPop === 'undefined') { showToast('Payment library failed to load'); reenable(); return; }
    const d = r.data;
    const handler = PaystackPop.setup({
      key: d.public_key,
      email: d.email || state.fund.email,
      amount: d.amount_kobo || amount_kobo,
      currency: 'NGN',
      ref: d.reference,
      callback: function(resp){
        fundVerifying = true;
        Promise.resolve(verifyTransaction((resp && resp.reference) || d.reference)).then(function(){
          fundVerifying = false;
          reenable();
        });
      },
      onClose: function(){ reenable(); }
    });
    handler.openIframe();
  } catch (e) {
    showToast('Network error. Try again.');
    reenable();
  }
}
async function verifyTransaction(reference){
  if (verifiedRefs.has(reference)) return;
  verifiedRefs.add(reference);
  try {
    const r = await api('/api/wallet/verify-transaction', {
      method: 'POST', headers: jsonHeaders(), body: JSON.stringify({ reference: reference })
    });
    if (r.res.ok && r.data.status === 'success') {
      handleFundSuccess(r.data, reference);
    } else {
      showToast(r.data.error || 'Payment not confirmed yet. Check your wallet shortly.');
    }
  } catch (e) {
    showToast('Could not verify payment. Check your wallet shortly.');
  }
}
function handleFundSuccess(data, reference){
  closeFundSheet();
  loadBalance();
  const amount_kobo = data.amount_kobo || Math.round(state.fund.amount * 100);
  const ref = data.reference || reference;
  const date = fmtDate(new Date().toISOString());
  $('receipt-amount').textContent = nairaFmt(amount_kobo);
  $('receipt-ref').textContent = ref;
  $('receipt-date').textContent = date;
  $('receipt-status').textContent = 'Paid';
  window._lastReceipt = { reference: ref, amount_kobo: amount_kobo, date: date, status: 'Paid', order_id: null };
  $('fund-amount').value = '';
  state.fund.amount = 0;
  highlightChips();
  goPage('pg-receipt');
}

/* ---------- Receipt PDF (no TXT path anywhere) ---------- */
// Fetches the REAL backend PDF for an order. Returns true when a PDF was saved.
async function fetchReceiptPdf(orderId, reference){
  try {
    const res = await fetch('/api/receipt/' + encodeURIComponent(orderId), { headers: getAuthHeader() });
    if (!res.ok) {
      if (res.status === 404) showToast('Receipt not found');
      else if (res.status === 405 || res.status === 501) showToast('Coming in backend update');
      else if (res.status === 403) showToast('You cannot download this receipt');
      else showToast('Could not download receipt');
      return false;
    }
    const blob = await res.blob();
    if (!blob || (blob.type && blob.type.indexOf('pdf') < 0)) { showToast('Receipt is not available as PDF'); return false; }
    saveBlob(blob, 'paylock-receipt-' + (reference || orderId) + '.pdf');
    return true;
  } catch (e) {
    showToast('Network error. Try again.');
    return false;
  }
}
async function downloadReceipt(){
  const r = window._lastReceipt;
  if (!r) { showToast('No receipt available'); return; }
  try {
    if (r.order_id) { await fetchReceiptPdf(r.order_id, r.reference); return; }
    // A wallet funding has no escrow order, so the backend has no receipt endpoint for it:
    // build the same one-page PDF here (still a real application/pdf file).
    const blob = buildPdf('PayLock Receipt', [
      ['Reference', r.reference], ['Type', 'Wallet funding'], ['Amount', pdfNaira(r.amount_kobo)],
      ['Date', r.date], ['Status', 'Paid']
    ]);
    saveBlob(blob, 'paylock-receipt-' + r.reference + '.pdf');
  } catch (e) { showToast('Could not create receipt'); }
}

