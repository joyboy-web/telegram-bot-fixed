/* ---------- Chat: send + button wiring (reuses buyProduct / confirmDelivery / disputeEscrow) ---------- */
function resetChatButtons(){
  [['pay-in-chat', 'Pay Now'], ['chat-confirm-btn', 'Confirm Delivery'], ['chat-dispute-btn', 'Dispute']].forEach(function(x){
    const b = document.getElementById(x[0]);
    if(b){ b.textContent = x[1]; b.disabled = false; }
  });
}

async function chatBuyFlow(btn){
  const p = chatState.product;
  if(!p || chatState.busy || chatState.stage !== 'ask') return;
  chatState.busy = true;
  try {
    const before = await chatFetchOrders();
    const known = {};
    before.forEach(function(o){ known[String(o.id)] = true; });
    await buyProduct(p.id, btn || document.getElementById('pay-in-chat'));
    const after = await chatFetchOrders();
    const fresh = after.filter(function(o){
      return !known[String(o.id)] && String(o.buyer_id) === String(state.telegram_id) && o.status === 'held';
    });
    const o = fresh.filter(function(x){ return String(x.product_id) === String(p.id); })[0] ||
              (fresh.every(function(x){ return x.product_id === undefined; }) ? fresh[0] : undefined);
    if(o){
      chatState.orderId = o.id;
      chatState.stage = 'paid';
      chatPush('paylock', "Your payment is held in escrow");
      chatPush('paylock', "Here is your file");
      chatPush('paylock', "How was it? Rate 1-5");
    } else {
      chatPush('system', "Purchase was not completed.");
    }
  } finally {
    chatState.busy = false;
    resetChatButtons();
    renderChatMessages();
    chatLoadRemote();
  }
}

async function chatOrderAction(btn, action, doneStatus, doneText){
  if(!chatState.orderId || chatState.busy || chatState.stage !== 'paid') return;
  chatState.busy = true;
  const oid = chatState.orderId;
  try {
    await action(oid, btn);
    const list = await chatFetchOrders();
    const o = list.filter(function(x){ return String(x.id) === String(oid); })[0];
    if(o && o.status === doneStatus && chatState.stage !== 'done'){
      chatState.stage = 'done';
      chatPush('system', doneText);
    }
  } finally {
    chatState.busy = false;
    resetChatButtons();
    renderChatMessages();
  }
}

async function sendChatMessage(){
  if(handleComplaintReply()) return;
  const input = document.getElementById('chat-input');
  if(!input || chatState.busy) return;
  const text = (input.value || '').trim();
  if(!text) return;
  input.value = '';
  // Before the purchase the room is the PayLock bot flow (reply 'yes').
  if(chatState.stage === 'ask' || !chatState.orderId || chatState.remoteOff){
    chatPush('user', text);
    if(chatState.stage === 'ask' && text.toLowerCase() === 'yes'){
      await chatBuyFlow(document.getElementById('pay-in-chat'));
    }
    return;
  }
  // After the purchase: a real message to the other party of this order.
  await chatSendRemote(text);
}

