/* ---------- PIN sheet ---------- */
function buildKeypad(){
  const kp = $('pin-keypad');
  clearNode(kp);
  ['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', 'back'].forEach(function(k){
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'key';
    if (k === '') { b.className = 'key blank'; b.disabled = true; }
    else if (k === 'back') b.appendChild(svgIcon(ICON_BACKSPACE, 24));
    else b.textContent = k;
    b.addEventListener('click', function(){ pinKey(k); });
    kp.appendChild(b);
  });
}
function pinTexts(mode){
  if (mode === 'set-new') return ['Create PIN', 'Choose a 4-digit PIN for withdrawals'];
  if (mode === 'set-confirm') return ['Confirm PIN', 'Enter your PIN again'];
  if (mode === 'delete') return ['Enter PIN', 'Enter your PIN to permanently delete your account'];
  return ['Enter PIN', 'Enter your 4-digit PIN to authorize this withdrawal'];
}
function renderPinHeader(){
  const t = pinTexts(pinModal.mode);
  $('pin-title').textContent = t[0];
  $('pin-sub').textContent = t[1];
}
function updateDots(){
  const dots = $('pin-dots').children;
  for (let i = 0; i < dots.length; i++) dots[i].classList.toggle('filled', i < pinModal.value.length);
}
function setPinError(msg){ $('pin-error').textContent = msg || ''; }
function setPinBusy(b){
  pinModal.busy = b;
  $('pin-keypad').style.visibility = b ? 'hidden' : 'visible';
}
function openPinModal(mode, opts){
  pinModal.mode = mode;
  pinModal.value = '';
  pinModal.firstPin = '';
  pinModal.after = (opts && opts.after) || null;
  pinModal.busy = false;
  pinModal.locked = false;
  renderPinHeader();
  updateDots();
  setPinError('');
  $('pin-action').style.display = 'none';
  $('pin-keypad').style.visibility = 'visible';
  $('pin-overlay').classList.add('open');
}
function openDeletePinModal(){ openPinModal('delete'); }
function closePinModal(){
  $('pin-overlay').classList.remove('open');
  pinModal.value = '';
  pinModal.firstPin = '';
  pinModal.busy = false;
  pinModal.locked = false;
  updateDots();
  setPinError('');
  $('pin-keypad').style.visibility = 'visible';
}
function pinAction(){
  openPinModal('set-new', { after: 'withdraw' });
}
function pinKey(k){
  if (pinModal.busy || pinModal.locked) return;
  if (k === 'back') pinModal.value = pinModal.value.slice(0, -1);
  else if (pinModal.value.length < 4) pinModal.value += k;
  updateDots();
  setPinError('');
  if (pinModal.value.length === 4) handlePinComplete();
}
function handlePinComplete(){
  const mode = pinModal.mode;
  const pin = pinModal.value;
  if (mode === 'set-new') {
    pinModal.firstPin = pin;
    pinModal.value = '';
    pinModal.mode = 'set-confirm';
    renderPinHeader();
    updateDots();
  } else if (mode === 'set-confirm') {
    if (pin !== pinModal.firstPin) {
      pinModal.mode = 'set-new';
      pinModal.firstPin = '';
      pinModal.value = '';
      renderPinHeader();
      updateDots();
      setPinError('PINs do not match. Try again.');
    } else {
      submitNewPin(pin);
    }
  } else if (mode === 'withdraw') {
    submitWithdrawalWithPin(pin);
  } else if (mode === 'delete') {
    submitAccountDeletion(pin);
  }
}
async function submitNewPin(pin){
  setPinBusy(true);
  try {
    const r = await api('/api/wallet/set-pin', { method: 'POST', headers: jsonHeaders(), body: JSON.stringify({ pin: pin, confirm_pin: pin }) });
    if (r.res.ok) {
      showToast('PIN set successfully');
      const after = pinModal.after;
      closePinModal();
      if (after === 'withdraw') setTimeout(function(){ openPinModal('withdraw'); }, 200);
    } else if (r.data.code === 'PIN_ALREADY_SET') {
      showToast('PIN already set');
      closePinModal();
    } else {
      pinModal.mode = 'set-new';
      pinModal.firstPin = '';
      pinModal.value = '';
      renderPinHeader();
      updateDots();
      setPinError(r.data.error || 'Could not set PIN');
    }
  } catch (e) {
    showToast('Network error. Try again.');
    closePinModal();
  } finally {
    setPinBusy(false);
  }
}
function handlePinError(res, data){
  const code = data && data.code;
  if (code === 'PIN_INVALID') {
    let msg = data.error || 'Incorrect PIN';
    if (typeof data.attempts_left === 'number') msg += ' (' + data.attempts_left + ' attempts left)';
    setPinError(msg);
    pinModal.value = '';
    updateDots();
  } else if (code === 'RATE_LIMITED' || res.status === 429) {
    setPinError(data.error || 'Too many attempts. Try again later.');
    pinModal.locked = true;
    pinModal.value = '';
    updateDots();
    setTimeout(closePinModal, 2000);
  } else if (code === 'PIN_NOT_SET') {
    setPinError('You have not set a PIN yet.');
    pinModal.value = '';
    updateDots();
    $('pin-action').style.display = 'block';
  } else {
    showToast(data.error || 'Request failed');
    closePinModal();
  }
}
async function submitWithdrawalWithPin(pin){
  if (!state.wd) { closePinModal(); return; }
  setPinBusy(true);
  try {
    const w = state.wd;
    const r = await api('/api/wallet/withdraw', {
      method: 'POST', headers: jsonHeaders(),
      body: JSON.stringify({
        amount_kobo: w.amount_kobo, pin: pin,
        bank_code: w.bank_code, bank_name: w.bank_name,
        account_number: w.account_number, account_name: w.account_name
      })
    });
    if (r.res.ok) {
      showToast('Withdrawal requested');
      closePinModal();
      $('wd-amount').value = '';
      state.wd = null;
      loadBalance();
      loadWithdrawals();
    } else {
      handlePinError(r.res, r.data);
    }
  } catch (e) {
    showToast('Network error. Try again.');
    closePinModal();
  } finally {
    if (!pinModal.locked) setPinBusy(false);
    else pinModal.busy = false;
  }
}

