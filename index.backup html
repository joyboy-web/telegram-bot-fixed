/* ----- multi-image gallery (main + extras from GET /api/products/<id>/images) ----- */
function httpsList(a){
  return a.filter(function(u){ return typeof u === 'string' && u.indexOf('https://') === 0; });
}
function pvImages(p){
  let a = [];
  ['images', 'image_urls', 'gallery'].forEach(function(k){
    if (!a.length && Array.isArray(p[k])) {
      a = p[k].map(function(x){ return typeof x === 'string' ? x : (x && (x.url || x.image_url)); });
    }
  });
  if (!a.length && p.image_url) a = [p.image_url];
  return httpsList(a).slice(0, 4);
}
function pvGallery(body, p){
  let imgs = pvImages(p);
  let cur = 0;
  const wrap = el('div');
  const main = document.createElement('img');
  main.className = 'pv-img';
  main.alt = '';
  wrap.appendChild(main);
  const row = el('div', 'pv-thumbs');
  wrap.appendChild(row);
  function draw(){
    if (cur >= imgs.length) cur = 0;
    if (!imgs.length) { main.style.display = 'none'; row.style.display = 'none'; return; }
    main.style.display = '';
    main.src = imgs[cur];
    clearNode(row);
    if (imgs.length < 2) { row.style.display = 'none'; return; }
    row.style.display = '';
    imgs.forEach(function(u, i){
      const t = document.createElement('img');
      t.className = 'pv-thumb' + (i === cur ? ' active' : '');
      t.alt = '';
      t.src = u;
      t.addEventListener('click', function(){ cur = i; draw(); });
      row.appendChild(t);
    });
  }
  draw();
  body.appendChild(wrap);
  // extras (max 3) come from the backend; merge them behind the main cover
  if (p && p.id !== undefined && p.id !== null) {
    api('/api/products/' + encodeURIComponent(p.id) + '/images', { headers: getAuthHeader() }).then(function(r){
      if (!r.res.ok || !wrap.isConnected) return;
      const extra = httpsList((Array.isArray(r.data.images) ? r.data.images : []).map(function(x){ return x && x.image_url; }));
      const merged = [];
      imgs.concat(extra).forEach(function(u){ if (merged.indexOf(u) < 0) merged.push(u); });
      imgs = merged.slice(0, 4);
      draw();
    }).catch(function(){ /* gallery stays with the cover only */ });
  }
}
