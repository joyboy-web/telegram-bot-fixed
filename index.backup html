  btn.disabled = true;
  // The N500 fee is charged by the backend only; the app never deducts anything itself.
  const r = await postApi('/api/boost', { product_id: p.id });
  if (r.ok) {
    p.is_boosted = true;
    p.boosted = true;
    if (r.data && r.data.boosted_until) p.boosted_until = r.data.boosted_until;
    renderMyProducts();
    loadBalance();
