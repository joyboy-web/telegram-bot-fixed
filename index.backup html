function openDeleteSheet(){
  $('delete-input').value = '';
  $('delete-btn').disabled = true;
  $('delete-overlay').classList.add('open');
}
function closeDeleteSheet(){
  $('delete-overlay').classList.remove('open');
  $('delete-input').value = '';
  $('delete-btn').disabled = true;
}
function onDeleteInput(){
  $('delete-btn').disabled = $('delete-input').value !== 'DELETE';
}
async function startDeleteFlow(){
  if ($('delete-input').value !== 'DELETE') return;
  const btn = $('delete-btn');
  btn.disabled = true;
  try {
    const r = await api('/api/wallet/pin-status', { headers: getAuthHeader() });
    if (!r.res.ok) { showToast(r.data.error || 'Could not check PIN status'); btn.disabled = false; return; }
    if (r.data.has_pin) {
      closeDeleteSheet();
      openDeletePinModal();
    } else {
      await submitAccountDeletion(null);
      btn.disabled = $('delete-input').value !== 'DELETE';
    }
  } catch (e) {
    showToast('Network error. Try again.');
    btn.disabled = false;
  }
}
async function submitAccountDeletion(pin){
  const viaPin = pin !== null && pin !== undefined;
  if (viaPin) setPinBusy(true);
  try {
    const r = await api('/api/account', {
      method: 'DELETE', headers: jsonHeaders(),
      body: JSON.stringify(viaPin ? { pin: pin } : { confirm: true })
    });
    if (r.res.status === 200 && r.data.deleted) {
      closePinModal();
      closeDeleteSheet();
      showDeletedGate();
    } else if (r.res.status === 409) {
      showToast(r.data.error || 'Withdraw funds and complete open orders first');
      closePinModal();
      closeDeleteSheet();
    } else if (viaPin) {
      handlePinError(r.res, r.data);
    } else {
      showToast(r.data.error || 'Could not delete account');
    }
  } catch (e) {
    showToast('Network error. Try again.');
    if (viaPin) closePinModal();
  } finally {
    if (viaPin) {
      if (!pinModal.locked) setPinBusy(false);
      else pinModal.busy = false;
    }
  }
}

