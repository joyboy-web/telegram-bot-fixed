function buildPdf(title, rows){
  const ops = ['BT /F2 20 Tf 50 790 Td (' + pdfText(title) + ') Tj ET'];
  let y = 750;
  rows.forEach(function(r){
    ops.push('BT /F2 11 Tf 50 ' + y + ' Td (' + pdfText(r[0]) + ') Tj ET');
    ops.push('BT /F1 11 Tf 210 ' + y + ' Td (' + pdfText(r[1]) + ') Tj ET');
    y -= 22;
  });
  const stream = ops.join('\n');
  const objs = [
    '<< /Type /Catalog /Pages 2 0 R >>',
    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
    '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R /F2 5 0 R >> >> /Contents 6 0 R >>',
    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>',
    '<< /Length ' + stream.length + ' >>\nstream\n' + stream + '\nendstream'
  ];
  let out = '%PDF-1.4\n';
  const offs = [];
  objs.forEach(function(b, i){ offs.push(out.length); out += (i + 1) + ' 0 obj\n' + b + '\nendobj\n'; });
  const xref = out.length;
  out += 'xref\n0 ' + (objs.length + 1) + '\n0000000000 65535 f \n';
  offs.forEach(function(o){ out += String(o).padStart(10, '0') + ' 00000 n \n'; });
  out += 'trailer\n<< /Size ' + (objs.length + 1) + ' /Root 1 0 R >>\nstartxref\n' + xref + '\n%%EOF\n';
  const bytes = new Uint8Array(out.length);
  for (let i = 0; i < out.length; i++) bytes[i] = out.charCodeAt(i) & 255;
  return new Blob([bytes], { type: 'application/pdf' });
}

/* ---------- Fees (must match backend calc_fees exactly) ---------- */
function computeFees(priceNaira){
  const price_kobo = Math.round(Number(priceNaira) * 100);
  let paystackFee;
  if (price_kobo <= 250000) paystackFee = Math.round(price_kobo * 0.015);
  else paystackFee = Math.round(price_kobo * 0.015 + 10000);
  paystackFee = Math.min(200000, paystackFee);
  const split = Math.round((PLATFORM_FEE + paystackFee) / 2);
  return {
    price_kobo: price_kobo,
    platform_fee: PLATFORM_FEE,
    paystack_fee: paystackFee,
    split: split,
    buyer_pays: price_kobo + split,
    seller_gets: price_kobo - split
  };
}
