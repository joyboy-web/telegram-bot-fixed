}
function filterBanks(keepSelection){
  const input = $('bank-search');
  const q = input.value.trim().toLowerCase();
  if (keepSelection !== true && input.value !== state.selectedBankName) {
    state.selectedBankCode = null;
    state.accountName = '';
    $('acct-name-row').classList.remove('show');
  }
  const matches = state.banks.filter(function(b){ return String(b.name || '').toLowerCase().indexOf(q) >= 0; });
  renderBankList(matches);
}
function renderBankList(list){
  const box = $('bank-list');
  clearNode(box);
  list.slice(0, 100).forEach(function(b){
    const opt = el('div', 'bank-opt', b.name);
