/* 10: client-side CSV from the already-loaded list */
function downloadTxCsv(){
  const rows = Array.isArray(state.transactions) ? state.transactions : [];
  if (!rows.length) { showToast('No transactions to download'); return; }
  const q = function(v){
    let s = String(v === undefined || v === null ? '' : v);
    if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;          // spreadsheet formula guard
    return '"' + s.replace(/"/g, '""') + '"';
  };
  const lines = [['Date', 'Reference', 'Description', 'Direction', 'Amount (NGN)', 'Status'].map(q).join(',')];
  rows.forEach(function(t){
    const credit = t.type === 'credit';
    const amt = (credit ? '' : '-') + ((Number(t.amount_kobo) || 0) / 100).toFixed(2);
    lines.push([q(t.created_at || ''), q(t.reference || ''), q(b7TxLabel(t)), q(credit ? 'Credit' : 'Debit'), amt, q(b7TxStatus(t))].join(','));
  });
  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
  const name = 'paylock-transactions.csv';
  try {
    // Telegram phone WebViews often ignore blob downloads: hand the file to the share sheet first
    const mobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent || '');
    if (mobile && typeof File === 'function' && navigator.canShare) {
      const f = new File([blob], name, { type: 'text/csv' });
      if (navigator.canShare({ files: [f] })) {
        navigator.share({ files: [f], title: name }).catch(function(err){ if (!err || err.name !== 'AbortError') _saveBlob(blob, name); });
        return;
      }
    }
  } catch (e) {}
  _saveBlob(blob, name);                                 // a.download = "paylock-transactions.csv"
}

/* 11: Auto-Boost UI (display + local preference only) */
const fxB = { days: 1, auto: false };
function fxBoostRender(){
  const seg = $('boost-dur');
  if (!seg) return;
  seg.querySelectorAll('button').forEach(function(b){ b.classList.toggle('active', Number(b.getAttribute('data-d')) === fxB.days); });
  const t = $('boost-auto-toggle'); if (t) t.classList.toggle('on', fxB.auto);
  let until = 0;
  (state.myProducts || []).concat(state.products.filter(isOwnProduct)).forEach(function(p){
    if (pBoosted(p)) { const u = boostUntilMs(p); if (u > until) until = u; }
  });
  const st = $('boost-status');
  if (!st) return;
  clearNode(st);
  const auto = ' - Auto-Reboost ' + (fxB.auto ? 'ON' : 'OFF');
  if (until) {
    st.appendChild(document.createTextNode('Boosted until ' + new Date(until).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) + ' - '));
    const ex = el('button', 'link-btn', 'Extend');
    ex.type = 'button';
    ex.addEventListener('click', function(){ goPage('pg-myproducts'); });
    st.appendChild(ex);
    st.appendChild(document.createTextNode(auto));
  } else {
    st.textContent = 'No active boost' + auto;
  }
}
function fx8Init(){
  // avatars + 3-dot icons
  ['chat-head-av', 'sup-head-av'].forEach(function(id){ const n = $(id); if (n) { clearNode(n); n.appendChild(fxAv('lock', 40)); } });
