/* ----- chat list (bot conversations) ----- */
function getChatMeta(id){
  try { const r = localStorage.getItem('paylock_cmeta_' + id); if (r) return JSON.parse(r); } catch (e) {}
  return null;
}
function setChatMeta(id, m){
  try { localStorage.setItem('paylock_cmeta_' + id, JSON.stringify(m)); } catch (e) {}
}
function chatTime(ts){
  const d = new Date(ts), now = new Date();
  if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString('en-NG', { hour: '2-digit', minute: '2-digit' });
  return d.toLocaleDateString('en-NG', { day: 'numeric', month: 'short' });
}
function chatMetaSync(){
  const p = chatState.product;
  if (!p) return;
  const id = String(p.id);
  const len = chatState.messages.length;
  let m = getChatMeta(id) || { len: len, seen: 0, ts: Date.now() };
  if (m.len !== len) { m.len = len; m.ts = Date.now(); }
  if (chatMode === 'room') m.seen = len;
  setChatMeta(id, m);
  if (chatMode === 'list') renderChatList();
}
function renderChatList(){
  const box = $('chat-list');
  if (!box) return;
  clearNode(box);
  const keys = [];
  try {
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.indexOf('paylock_chat_') === 0) keys.push(k);
    }
  } catch (e) {}
  const rows = [];
  keys.forEach(function(k){
    let s = null;
    try { s = JSON.parse(localStorage.getItem(k)); } catch (e) { s = null; }
    if (!s || !s.product || !Array.isArray(s.messages) || !s.messages.length) return;
    const p = s.product;
    if (isOwnProduct(p)) return;
    const id = String(p.id);
    const n = s.messages.length;
    let m = getChatMeta(id);
    if (!m) { m = { len: n, seen: n, ts: Date.now() }; setChatMeta(id, m); }
    else if (m.len !== n) { m.len = n; m.ts = Date.now(); setChatMeta(id, m); }
    let unread = 0;
    for (let j = Math.min(m.seen, n); j < n; j++) {
      if (s.messages[j] && s.messages[j].role !== 'user') unread++;
    }
    rows.push({ p: p, msgs: s.messages, ts: m.ts, unread: unread });
  });
  rows.sort(function(a, b){ return b.ts - a.ts; });
  if (!rows.length) {
    const e = el('div', 'empty');
    e.appendChild(el('div', 'big', 'No conversations yet'));
    box.appendChild(e);
    return;
  }
  rows.forEach(function(r){
    const row = el('div', 'chat-row');
    if (typeof r.p.image_url === 'string' && r.p.image_url.indexOf('https://') === 0) {
      const img = document.createElement('img');
      img.className = 'chat-thumb';
      img.alt = '';
      img.loading = 'lazy';
      img.src = r.p.image_url;
      row.appendChild(img);
    } else {
      const ph = el('div', 'chat-thumb');
      ph.appendChild(svgIcon(['M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'], 20));
      row.appendChild(ph);
    }
    const mid = el('div', 'mid');
    mid.appendChild(el('div', 't', r.p.title || r.p.name || r.p.product_name || 'Product'));
    const last = r.msgs[r.msgs.length - 1];
    mid.appendChild(el('div', 's', last && last.text ? last.text : ''));
    row.appendChild(mid);
    const meta = el('div', 'chat-meta');
    meta.appendChild(el('div', 'chat-time', chatTime(r.ts)));
    if (r.unread > 0) meta.appendChild(el('div', 'chat-badge', String(r.unread > 99 ? '99+' : r.unread)));
    row.appendChild(meta);
    row.addEventListener('click', function(){ enterChatRoom(); openChat(r.p); });
    box.appendChild(row);
  });
}

