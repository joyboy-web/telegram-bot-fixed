async function retryLast(){
  const b = $('offline-retry');
  if (b) b.disabled = true;
  try {
    // Only GET-style calls are re-run; mutations are never replayed automatically.
    if (lastApi && (!lastApi.opts || !lastApi.opts.method || String(lastApi.opts.method).toUpperCase() === 'GET')) {
      await api(lastApi.path, lastApi.opts);
