/* ---------- Boost expiry (uses boosted_until from the API; the fee is charged by the backend only) ---------- */
function boostUntilMs(p){
  const t = Date.parse(p && p.boosted_until);
  return isNaN(t) ? 0 : t;
}
function pBoosted(p){
  if (!p) return false;
  const u = boostUntilMs(p);
  if (u) return u > Date.now();            // an expired boost is never shown
  return !!(p.boosted || p.is_boosted);
}
function boostText(untilMs){
  const ms = Math.max(0, untilMs - Date.now());
  const h = Math.floor(ms / 3600000);
  const m = Math.floor((ms % 3600000) / 60000);
  return 'Boosted - Expires in ' + h + 'h ' + m + 'm';
}
function boostBadge(p){
  if (!pBoosted(p)) return null;
  const u = boostUntilMs(p);
  const b = el('span', 'badge b-boost boost-badge', u ? boostText(u) : 'Boosted');
  if (u) b.setAttribute('data-until', String(u));
  return b;
}

