function setTxFilter(f){
  state.txFilter = f;
  document.querySelectorAll('#tx-chips .chip').forEach(function(c){
    c.classList.toggle('active', c.getAttribute('data-filter') === f);
  });
  renderTransactions();
}
function renderTransactions(){
  const list = $('tx-list'), empty = $('tx-empty');
  clearNode(list);
  const f = state.txFilter;
  const rows = state.transactions.filter(function(t){
    const reason = String(t.reason || '');
    if (f === 'credits') return t.type === 'credit';
    if (f === 'debits') return t.type === 'debit';
    if (f === 'withdrawals') return reason.indexOf('withdraw') >= 0;
    if (f === 'funding') return reason.indexOf('funding') >= 0;
    if (f === 'purchase') return reason.indexOf('purchase') >= 0 || reason.indexOf('escrow_hold') >= 0;
    if (f === 'sale') return reason.indexOf('escrow_release') >= 0 && t.type === 'credit';
    return true;
  });
  if (!rows.length) { empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  rows.forEach(function(t){
    const isCredit = t.type === 'credit';
    const item = el('div', 'item');
    const ic = el('div', 'icon-circle ' + (isCredit ? 'credit' : 'debit'));
    ic.appendChild(svgIcon(isCredit ? ICON_DOWN : ICON_UP, 18));
    item.appendChild(ic);
    const mid = el('div', 'mid');
    const reason = String(t.reason || '');
    mid.appendChild(el('div', 't', TX_LABELS[reason] || (reason ? reason.replace(/_/g, ' ') : (isCredit ? 'Credit' : 'Debit'))));
    mid.appendChild(el('div', 's', fmtDate(t.created_at) + (t.reference ? ' · ' + t.reference : '')));
    item.appendChild(mid);
    item.appendChild(el('div', 'amt ' + (isCredit ? 'credit' : 'debit'), (isCredit ? '+' : '-') + nairaFmt(t.amount_kobo)));
    list.appendChild(item);
  });
}

