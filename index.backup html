/* ----- Support Chat profile: in-app tickets (POST/GET /api/support) ----- */
const supportState = { tickets: [], off: false };
function renderSupport(){
  const box = $('support-thread');
  if (!box) return;
  clearNode(box);
  if (supportState.off) {
    box.appendChild(el('div', 'empty', 'Coming in backend update'));
    return;
  }
  if (!supportState.tickets.length) {
    box.appendChild(el('div', 'chat-msg chat-msg-system', 'Describe your issue and our team will reply. Include your order reference if it is about an order.'));
    return;
  }
  const USER_ROLES = { user: 1, customer: 1, client: 1, buyer: 1, seller: 1, me: 1, self: 1 };
  const textOf = function(m){
    if (m === undefined || m === null) return '';
    if (typeof m === 'string') return m.trim();
    if (typeof m !== 'object') return '';
    const v = (m.message !== undefined && m.message !== null) ? m.message : m.text;
    return (v === undefined || v === null) ? '' : String(v).trim();
  };
  const addUser = function(text){
    box.appendChild(el('div', 'chat-msg chat-msg-user', text));
  };
  const addStaff = function(text, ts){
    const d = el('div', 'chat-msg chat-msg-paylock');
    d.appendChild(el('div', 'chat-msg-label', 'Support'));
    d.appendChild(document.createTextNode(text));
    box.appendChild(d);
    const meta = el('div', 'support-meta', fmtDate(ts));
    meta.style.alignSelf = 'flex-start';
    box.appendChild(meta);
  };
  supportState.tickets.slice().reverse().forEach(function(t){
    try {
      if (!t || typeof t !== 'object') return;
      const own = textOf(t.message);
      const fallbackTs = t.reply_created_at || t.updated_at || t.created_at;
      const metaLine = function(){
        box.appendChild(el('div', 'support-meta', String(t.status || 'pending') + ' · ' + fmtDate(t.created_at)));
      };
      // Shape: t.messages = both sides in order
      const thread = Array.isArray(t.messages) ? t.messages.filter(function(m){ return textOf(m); }) : [];
      if (thread.length) {
        thread.forEach(function(m, i){
          const txt = textOf(m);
          const role = String((m && (m.sender || m.role || m.sender_role)) || '').toLowerCase();
          const isUser = !!(m && m.is_mine === true) || !!USER_ROLES[role] || (!role && own && txt === own);
          if (isUser) {
            addUser(txt);
            box.appendChild(el('div', 'support-meta', (i === 0 ? String(t.status || 'pending') + ' · ' : '') + fmtDate((m && m.created_at) || t.created_at)));
          } else {
            addStaff(txt, (m && m.created_at) || fallbackTs);
          }
        });
        return;
      }
      // Default: the user's own message + status + date (unchanged behaviour)
      addUser(String(t.message || ''));
      metaLine();
      // Staff replies: string fields and t.replies, de-duplicated, never an empty bubble
      const seen = {};
      const push = function(txt, ts){
        if (!txt || seen[txt]) return;
        seen[txt] = true;
        addStaff(txt, ts || fallbackTs);
      };
      [t.reply, t.admin_reply, t.response].forEach(function(s){
        if (typeof s === 'string') push(s.trim(), fallbackTs);
      });
      if (Array.isArray(t.replies)) {
        t.replies.forEach(function(m){ push(textOf(m), m && m.created_at); });
      }
    } catch (e) { /* one bad ticket must never break the thread */ }
  });
  try { box.scrollTop = box.scrollHeight; } catch (e) {}
}
async function loadSupport(){
  try {
    const r = await api('/api/support', { headers: getAuthHeader() });
    if (r.res.status === 501 || r.res.status === 404 || r.res.status === 405) { supportState.off = true; }
    else if (r.res.ok) { supportState.off = false; supportState.tickets = Array.isArray(r.data.tickets) ? r.data.tickets : []; }
  } catch (e) { /* keep what we have */ }
  renderSupport();
}
async function sendSupport(){
  const input = $('support-input');
  const btn = $('support-send');
  if (!input || !btn || btn.disabled) return;
  const text = (input.value || '').trim();
  if (!text) return;
  btn.disabled = true;
  try {
    const r = await postApi('/api/support', { message: text.slice(0, 1000) });
    if (r.ok) { input.value = ''; showToast('Message sent'); await loadSupport(); }
    else if (r.soon) { supportState.off = true; renderSupport(); }
  } finally {
    btn.disabled = false;
  }
}
function goSupport(){
  chatProfile = 'support';
  chatMode = 'list';
  applyChatMode();
  goPage('pg-chat');
}

function applyChatMode(){
  const pg = $('pg-chat');
  if (!pg) return;
  pg.classList.toggle('chat-list-mode', chatMode === 'list');
  if (chatMode !== 'list') return;
  document.querySelectorAll('#chat-profiles .chip').forEach(function(c){
    c.classList.toggle('active', c.getAttribute('data-profile') === chatProfile);
  });
  $('chat-list').style.display = chatProfile === 'bot' ? '' : 'none';
  $('chat-orders').style.display = chatProfile === 'seller' ? '' : 'none';
  $('chat-support').style.display = chatProfile === 'support' ? '' : 'none';
  if (chatProfile === 'bot') renderChatList();
  else if (chatProfile === 'seller') loadOrderChats();
  else loadSupport();
}
