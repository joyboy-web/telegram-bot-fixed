    }
    const img = m && (m.image_url || m.image);
    if (typeof img === 'string' && img.indexOf('https://') === 0) {
      const im = document.createElement('img');
      im.className = 'sup-img'; im.alt = ''; im.loading = 'lazy'; im.src = img;
      d.appendChild(im);
    }
    if (text) d.appendChild(el('div', 'sup-txt', text));
    const meta = el('div', 'sup-meta');
    meta.appendChild(el('span', 'sup-time', supTime(ts)));
    if (mine) meta.appendChild(supTickEl(supTick(status)));
    d.appendChild(meta);
    box.appendChild(d);
  };
  const addUser = function(text, ts, status, m){ supBubble(true, text, ts, status, m); };
  const addStaff = function(text, ts, m){ supBubble(false, text, ts, '', m); };
  supportState.tickets.slice().reverse().forEach(function(t){
    try {
      if (!t || typeof t !== 'object') return;
      const own = textOf(t.message);
      const fallbackTs = t.reply_created_at || t.updated_at || t.created_at;
      const metaLine = function(){
      };
      // Shape: t.messages = both sides in order
      const thread = Array.isArray(t.messages) ? t.messages.filter(function(m){ return textOf(m); }) : [];
      if (thread.length) {
        thread.forEach(function(m, i){
          const txt = textOf(m);
          const role = String((m && (m.sender || m.role || m.sender_role)) || '').toLowerCase();
          const isUser = !!(m && m.is_mine === true) || !!USER_ROLES[role] || (!role && own && txt === own);
          if (isUser) {
            addUser(txt, (m && m.created_at) || t.created_at, t.status, m);
          } else {
            addStaff(txt, (m && m.created_at) || fallbackTs, m);
          }
        });
        return;
      }
      // Default: the user's own message + status + date (unchanged behaviour)
      addUser(String(t.message || ''), t.created_at, (t.reply || t.admin_reply || t.response || (Array.isArray(t.replies) && t.replies.length)) ? 'read' : t.status, t);
      metaLine();
      // Staff replies: string fields and t.replies, de-duplicated, never an empty bubble
      const seen = {};
      const push = function(txt, ts){
        if (!txt || seen[txt]) return;
        seen[txt] = true;
        addStaff(txt, ts || fallbackTs);
      };
      [t.reply, t.admin_reply, t.response].forEach(function(s){
        if (typeof s === 'string') push(s.trim(), fallbackTs);
      });
      if (Array.isArray(t.replies)) {
        t.replies.forEach(function(m){ push(textOf(m), m && m.created_at); });
      }
    } catch (e) { /* one bad ticket must never break the thread */ }
  });
  try { box.scrollTop = box.scrollHeight; } catch (e) {}
}
