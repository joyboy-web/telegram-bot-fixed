/* ---------- Sell: uploads ---------- */
async function getFileFingerprint(file){
  const base = file.name + '|' + file.size + '|' + file.lastModified;
  try {
    const buf = await file.slice(0, 1048576).arrayBuffer();
    const digest = await crypto.subtle.digest('SHA-256', buf);
    const hex = Array.from(new Uint8Array(digest)).map(function(b){ return b.toString(16).padStart(2, '0'); }).join('');
    return base + '|' + hex;
  } catch (e) {
    return base;
  }
}
function attachUploadListeners(){
  const c = $('cover-input'), f = $('file-input');
  if (c) c.addEventListener('change', handleCover);
  if (f) f.addEventListener('change', handleFile);
}
function resetUploadBoxes(){
  state.coverFile = null;
  state.productFile = null;
  $('cover-box').innerHTML = COVER_BOX_HTML; // static markup only
  $('file-box').innerHTML = FILE_BOX_HTML;   // static markup only
  attachUploadListeners();
  clearExtras();
}
function makeInput(id, accept, handler){
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.id = id;
  inp.accept = accept;
  inp.hidden = true;
  inp.addEventListener('change', handler);
  return inp;
}
function handleCover(e){
  const file = e.target.files && e.target.files[0];
  if (!file) return;
  const okTypes = ['image/jpeg', 'image/png', 'image/webp'];
  if (okTypes.indexOf(file.type) < 0) { showToast('Cover must be JPG, PNG or WEBP'); e.target.value = ''; return; }
  if (file.size > MAX_IMG_BYTES) { showToast('Cover image must be 5MB or less'); e.target.value = ''; return; }
  state.coverFile = file;
  const reader = new FileReader();
  reader.onload = function(){
    const box = $('cover-box');
    clearNode(box);
    const img = document.createElement('img');
    img.src = reader.result;
    img.alt = '';
    img.style.maxHeight = '120px';
    box.appendChild(img);
    box.appendChild(el('div', 'fname', file.name.length > 80 ? file.name.slice(0, 77) + '...' : file.name));
    box.appendChild(makeInput('cover-input', 'image/jpeg,image/png,image/webp', handleCover));
  };
  reader.readAsDataURL(file);
}
async function handleFile(e){
  const input = e.target;
  const file = input.files && input.files[0];
  if (!file) return;
  const lower = file.name.toLowerCase();
  const okExt = ['.zip', '.pdf', '.mp4', '.docx'].some(function(x){ return lower.endsWith(x); });
  if (!okExt) { showToast('File must be ZIP, PDF, MP4 or DOCX'); input.value = ''; return; }
  if (file.size > 50 * 1024 * 1024) { showToast('Product file must be 50MB or less'); input.value = ''; return; }
  const fp = await getFileFingerprint(file);
  if (uploadedFileFingerprints.has(fp)) {
    showToast('This file was already uploaded');
    input.value = '';
    return;
  }
  state.productFile = file;
  const box = $('file-box');
  clearNode(box);
  box.appendChild(svgIcon(ICON_FILE, 28));
  box.appendChild(el('div', 'fname', file.name.length > 80 ? file.name.slice(0, 77) + '...' : file.name));
  box.appendChild(makeInput('file-input', '.zip,.pdf,.mp4,.docx', handleFile));
}

/* ----- extra images (max 3, same validation as the cover) ----- */
function renderExtras(){
  const box = $('extra-thumbs'), cnt = $('extra-count');
  if (!box) return;
  clearNode(box);
  state.extraFiles.forEach(function(x, i){
    const t = el('div', 'extra-thumb');
    const img = document.createElement('img');
    img.alt = '';
    img.src = x.url;
    t.appendChild(img);
    const rm = el('button');
    rm.type = 'button';
    rm.setAttribute('aria-label', 'Remove image');
    rm.appendChild(svgIcon(ICON_CLOSE, 12));
    rm.addEventListener('click', function(ev){
      ev.preventDefault();
      ev.stopPropagation();
      try { URL.revokeObjectURL(x.url); } catch (e) {}
      state.extraFiles.splice(i, 1);
      renderExtras();
    });
    t.appendChild(rm);
    box.appendChild(t);
  });
  if (cnt) cnt.textContent = '(optional, ' + state.extraFiles.length + ' / ' + MAX_EXTRA + ')';
}
function clearExtras(){
  state.extraFiles.forEach(function(x){ try { URL.revokeObjectURL(x.url); } catch (e) {} });
  state.extraFiles = [];
  renderExtras();
}
function handleExtra(e){
  const files = Array.prototype.slice.call(e.target.files || []);
  e.target.value = '';
  const okTypes = ['image/jpeg', 'image/png', 'image/webp'];
  files.forEach(function(f){
    if (state.extraFiles.length >= MAX_EXTRA) { showToast('Maximum 3 extra images'); return; }
    if (okTypes.indexOf(f.type) < 0) { showToast('Extra images must be JPG, PNG or WEBP'); return; }
    if (f.size > MAX_IMG_BYTES) { showToast('Each image must be 5MB or less'); return; }
    state.extraFiles.push({ file: f, url: URL.createObjectURL(f) });
  });
  renderExtras();
}

async function submitSellForm(e){
  e.preventDefault();
  if (state.submitting) return;
  const name = $('sell-name').value.trim();
  const description = $('sell-desc').value.trim();
  const category = $('sell-category').value;
  const priceRaw = $('sell-price').value.replace(/[^0-9.]/g, '');
  const price = parseFloat(priceRaw);
  // Snapshot files BEFORE any await/POST so later state changes cannot affect this request.
  const coverFile = state.coverFile;
  const productFile = state.productFile;
  const extraFiles = state.extraFiles.map(function(x){ return x.file; }).slice(0, MAX_EXTRA);
  if (!coverFile) { showToast('Cover image is required - please re-select'); return; }
  if (!name) { showToast('Enter a product name'); return; }
  if (!(price > 0)) { showToast('Enter a valid price'); return; }
  const btn = $('sell-submit');
  state.submitting = true;
  btn.disabled = true;
  const origText = btn.textContent;
  btn.textContent = 'Listing...';
  try {
    // Fingerprint the product file ONLY (never the cover), and only if one was chosen.
    let fp = null;
    if (productFile) {
      fp = await getFileFingerprint(productFile);
      if (uploadedFileFingerprints.has(fp)) {
        showToast('This file was already uploaded');
        return;
      }
    }
    // Field names match the POST /api/products contract in app.py.
    const fd = new FormData();
    fd.append('name', name);
    fd.append('description', description);
    fd.append('category', category);
    fd.append('price_naira', String(price));
    fd.append('cover', coverFile);
    if (productFile) fd.append('product_file', productFile);
    extraFiles.forEach(function(f){ fd.append('extra_images', f); });   // repeatable field, max 3
    const r = await api('/api/products', { method: 'POST', headers: getAuthHeader(), body: fd });
    if (r.res.status === 201 || r.res.ok) {
      if (fp) uploadedFileFingerprints.add(fp);
      $('sell-form').reset();
      resetUploadBoxes();
      resetFeePreview();
      showToast('Product listed');
      loadProducts();
      goPage('pg-home');
    } else {
      showToast(r.data.error || 'Could not list product');
    }
  } catch (err) {
    showToast('Network error. Try again.');
  } finally {
    state.submitting = false;
    btn.disabled = false;
    btn.textContent = origText;
  }
}

