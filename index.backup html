    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>',
    '<< /Length ' + stream.length + ' >>\nstream\n' + stream + '\nendstream'
  ];
  let out = '%PDF-1.4\n';
  const offs = [];
  objs.forEach(function(b, i){ offs.push(out.length); out += (i + 1) + ' 0 obj\n' + b + '\nendobj\n'; });
  const xref = out.length;
  out += 'xref\n0 ' + (objs.length + 1) + '\n0000000000 65535 f \n';
  offs.forEach(function(o){ out += String(o).padStart(10, '0') + ' 00000 n \n'; });
  out += 'trailer\n<< /Size ' + (objs.length + 1) + ' /Root 1 0 R >>\nstartxref\n' + xref + '\n%%EOF\n';
  const bytes = new Uint8Array(out.length);
  for (let i = 0; i < out.length; i++) bytes[i] = out.charCodeAt(i) & 255;
  return new Blob([bytes], { type: 'application/pdf' });
}

/* ---------- Fees (must match backend calc_fees exactly) ---------- */
function computeFees(priceNaira){
  const price_kobo = Math.round(Number(priceNaira) * 100);
  let paystackFee;
  if (price_kobo <= 250000) paystackFee = Math.round(price_kobo * 0.015);
  else paystackFee = Math.round(price_kobo * 0.015 + 10000);
  paystackFee = Math.min(200000, paystackFee);
  const split = Math.round((PLATFORM_FEE + paystackFee) / 2);
  return {
    price_kobo: price_kobo,
    platform_fee: PLATFORM_FEE,
    paystack_fee: paystackFee,
    split: split,
    buyer_pays: price_kobo + split,
    seller_gets: price_kobo - split
  };
}
function updateFeePreview(){
  const priceRaw = $('sell-price').value.replace(/[^0-9.]/g, '');
  const price = parseFloat(priceRaw);
  if (!(price > 0)) { resetFeePreview(); return; }
  const f = computeFees(price);
  $('fp-product').textContent = nairaFmt(f.price_kobo);
  $('fp-escrow').textContent = nairaFmt(f.split);
  $('fp-buyer').textContent = nairaFmt(f.buyer_pays);
  $('fp-seller').textContent = nairaFmt(f.seller_gets);
}
function resetFeePreview(){
  ['fp-product', 'fp-escrow', 'fp-buyer', 'fp-seller'].forEach(function(id){ $(id).textContent = '₦0.00'; });
}

/* ---------- Auth + fetch ---------- */
// initData is read LIVE from tg on every request; it is never stored.
function getAuthHeader(){
  const initData = (tg && tg.initData) ? tg.initData : '';
  return { 'Authorization': 'tma ' + initData, 'X-Telegram-Init-Data': initData };
}
function jsonHeaders(){
  return Object.assign({ 'Content-Type': 'application/json' }, getAuthHeader());
}
async function api(path, opts){
  let res;
  lastApi = { path: path, opts: opts };
  try {
    res = await fetch(path, opts || {});
  } catch (err) {
    // The offline GATE is only for boot. After boot a failure only shows the retry banner.
    if (!booted && !navigator.onLine) showGate('offline');
    showOfflineBanner();
    throw err;
  }
  hideOfflineBanner();
  let data = {};
  try { data = await res.json(); } catch (e) { data = {}; }
  if (res.status === 403 && data && data.code === 'ACCOUNT_DELETED') showDeletedGate();
  if (data && data.code === 'ACCOUNT_BANNED') { state.banned = true; renderBanBanner(); }
  return { res: res, data: data || {} };
}

