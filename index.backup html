const GATES = ['loading', 'blocked', 'error', 'offline', 'deleted'];
function showGate(name){
  GATES.forEach(function(g){
    const n = $('gate-' + g);
    if (n) n.classList.toggle('show', g === name);
  });
}
function hideGates(){ GATES.forEach(function(g){ const n = $('gate-' + g); if (n) n.classList.remove('show'); }); }
