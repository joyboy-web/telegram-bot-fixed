      const role = String(q.role || q.sender || '').toLowerCase();
      const gold = /staff|support|paylock|admin/.test(role);
      const qb = el('div', 'sup-q ' + (gold ? 'gold' : 'purple'));
      qb.appendChild(el('div', 'sup-q-n', String(q.name || (gold ? 'PayLock' : 'You'))));
      qb.appendChild(el('div', 'sup-q-t', String(q.text || q.message)));
