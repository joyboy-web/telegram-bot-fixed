/* ---------- Theme: ALWAYS follows Telegram (colorScheme + themeParams + themeChanged) ---------- */
function setThemeIcon(){
  const b = $('theme-btn');
  if (b) b.innerHTML = (document.documentElement.getAttribute('data-theme') === 'dark') ? ICON_MOON : ICON_SUN; // static SVG constants only
}
// Removes any inline colour overrides so the pure black & white palettes in CSS apply exactly.
function clearThemeInline(){
  try {
    const st = document.documentElement.style;
    ['--bg', '--ink', '--muted', '--card'].forEach(function(k){ st.removeProperty(k); });
  } catch (e) {}
}
function detectScheme(){
  try {
    if (tg && tg.colorScheme) return tg.colorScheme === 'dark' ? 'dark' : 'light';
    const tp = (tg && tg.themeParams) || {};
    if (tp.bg_color && /^#[0-9a-fA-F]{6}$/.test(tp.bg_color)) {
      const r = parseInt(tp.bg_color.slice(1, 3), 16), g = parseInt(tp.bg_color.slice(3, 5), 16), b = parseInt(tp.bg_color.slice(5, 7), 16);
      return (0.299 * r + 0.587 * g + 0.114 * b) < 128 ? 'dark' : 'light';
    }
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
  } catch (e) {}
  return 'light';
}
function syncTelegramChrome(){
  try {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    const c = dark ? '#000000' : '#FFFFFF';
    if (tg && tg.setHeaderColor) tg.setHeaderColor(c);
    if (tg && tg.setBackgroundColor) tg.setBackgroundColor(c);
  } catch (e) {}
}
function loadTheme(){
  clearThemeInline();
  document.documentElement.setAttribute('data-theme', detectScheme());
  setThemeIcon();
  syncTelegramChrome();
}

/* ---------- Navigation ---------- */
function goPage(id){
  let target = $(id);
  if (!target) { id = 'pg-home'; target = $(id); }   // never throws on a missing page
  if (!target) return;
  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('active'); });
  target.classList.add('active');
  const mainTabs = ['pg-home', 'pg-sell', 'pg-chat', 'pg-buy', 'pg-wallet'];
  const activeTab = mainTabs.indexOf(id) >= 0 ? id : (id === 'pg-preview' ? 'pg-buy' : (id === 'pg-myproducts' ? 'pg-sell' : 'pg-wallet'));
  document.querySelectorAll('.tab').forEach(function(t){
    t.classList.toggle('active', t.getAttribute('data-tab') === activeTab);
  });
  try { window.scrollTo(0, 0); document.documentElement.scrollTop = 0; document.body.scrollTop = 0; } catch (e) {}
  try {
    if (id === 'pg-wallet') { loadBalance(); loadEscrowOrders(); loadReferrals(); }
    else if (id === 'pg-tx') { loadTransactions(); }
    else if (id === 'pg-withdraw') { loadBalance(); loadBanks(); loadWithdrawals(); }
    else if (id === 'pg-buy' || id === 'pg-home') { loadProducts(); renderBanBanner(); }
    else if (id === 'pg-myproducts') { loadMyProducts(); }
  } catch (e) { /* a failed loader must never break navigation */ }
}

