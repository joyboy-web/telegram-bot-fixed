/* ----- generic helpers ----- */
async function postApi(path, body, silentSoon, method){
  try {
    const r = await api(path, { method: method || 'POST', headers: jsonHeaders(), body: JSON.stringify(body || {}) });
    const s = r.res.status;
    if (s === 404 || s === 405 || s === 501) {
      if (!silentSoon) showToast('Coming in backend update');
      return { ok: false, soon: true, data: r.data };
    }
    if (!r.res.ok) { showToast(r.data.error || 'Request failed'); return { ok: false, data: r.data }; }
    return { ok: true, data: r.data };
  } catch (e) {
    showToast('Network error. Try again.');
    return { ok: false };
  }
}
