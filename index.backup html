<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>PayLock</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://js.paystack.co/v1/inline.js"></script>
<style>
:root{
  --bg:#FFFFFF; --card:#FFFFFF; --ink:#000000; --muted:#6B7280; --line:#EAECEF;
  --chip:#F3F4F6; --green:#16A34A; --red:#DC2626; --amber:#D97706;
}
[data-theme="dark"]{
  --bg:#000000; --card:#0E0E0F; --ink:#FFFFFF; --muted:#9CA3AF; --line:#26282B; --chip:#1F2124;
}
.theme-btn{background:var(--chip);border:0;border-radius:10px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:var(--ink)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:15px;line-height:1.45}
button{font-family:inherit;color:inherit;cursor:pointer}
button:active,.upload-box:active,.row-link:active,.tab:active,.key:active{transform:scale(0.97)}
.app-shell{max-width:440px;margin:0 auto;min-height:100vh;padding:16px 16px calc(92px + env(safe-area-inset-bottom))}
.page{display:none}
.page.active{display:block}
h1,h2,h3,p{margin:0}
.muted{color:var(--muted)}
.small{font-size:12.5px}
.page-title{font-size:22px;font-weight:800;margin-bottom:14px}
.back-btn{display:inline-flex;align-items:center;gap:6px;background:var(--chip);border:0;border-radius:12px;padding:8px 12px;font-weight:600;font-size:14px;margin-bottom:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px}
.card-title{font-weight:700;font-size:15px;margin-bottom:10px}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;background:var(--ink);color:var(--bg);border:1px solid var(--ink);border-radius:14px;padding:13px 16px;font-weight:700;font-size:15px;text-decoration:none}
.btn.secondary{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.danger{background:var(--red);border-color:var(--red);color:#fff}
.btn.sm{width:auto;padding:8px 12px;font-size:13px;border-radius:10px}
.btn:disabled{opacity:0.45;cursor:not-allowed}
.btn-row{display:flex;gap:10px}
.btn-row .btn{flex:1}

/* Inputs */
.field{margin-bottom:12px}
.field label{display:block;font-size:12.5px;font-weight:600;color:var(--muted);margin-bottom:6px}
.input,.select,.textarea{width:100%;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:12px;font-family:inherit;font-size:16px;outline:none}
.input:focus,.select:focus,.textarea:focus{border-color:var(--ink)}
.textarea{min-height:80px;resize:vertical}

/* Home */
.hello{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.hello h1{font-size:26px;font-weight:800}
.welcome{font-size:13px;color:var(--muted);font-weight:600}
.balance-card{background:var(--card);color:var(--ink);border-radius:24px;padding:22px;margin:16px 0;border:1px solid var(--line);position:relative}
.balance-card .label{font-size:13px;color:var(--muted);font-weight:600}
.balance-card .amount{font-size:36px;font-weight:800;margin:6px 0 4px;letter-spacing:-0.8px}
.balance-card .idline{font-size:12px;color:var(--muted);margin-bottom:14px}
.bal-held{display:flex;justify-content:space-between;align-items:center;gap:10px;background:var(--chip);border-radius:14px;padding:10px 12px;margin:0 0 14px;font-size:13px}
.bal-held .bh-k{color:var(--muted);font-weight:600}
.bal-held .bh-v{font-weight:800}
.eye-btn{position:absolute;top:16px;right:16px;background:var(--chip);border:0;border-radius:10px;width:36px;height:36px;color:var(--ink);display:flex;align-items:center;justify-content:center}
.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
.quick button{background:var(--chip);border:0;border-radius:14px;padding:14px 8px;font-weight:700;font-size:14px}
.section-title{font-size:16px;font-weight:800;margin:6px 0 10px}

/* Product grid */
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.pcard{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:10px;display:flex;flex-direction:column;gap:8px}
.pcard .pimg{width:100%;aspect-ratio:1/1;border-radius:12px;background:var(--chip);object-fit:cover;display:block}
.pcard .ptitle{font-weight:700;font-size:14px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:36px}
.pcard .pprice{font-weight:800;font-size:15px}
.empty{text-align:center;color:var(--muted);padding:36px 12px;font-size:14px}
.empty .big{font-weight:700;color:var(--ink);font-size:16px;margin-bottom:4px}

/* Sell */
.upload-box{display:block;border:1.5px dashed var(--line);border-radius:16px;padding:16px;text-align:center;cursor:pointer;margin-bottom:12px;background:var(--card);color:var(--ink)}
.upload-box .ub-title{font-weight:700;margin-top:6px}
.upload-box .ub-sub{font-size:12px;color:var(--muted);margin-top:2px}
.upload-box img{max-width:100%;border-radius:10px;display:block;margin:0 auto 6px}
.upload-box .fname{font-weight:600;font-size:13px;word-break:break-all;margin-top:6px}
.extra-thumbs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.extra-thumb{position:relative;width:76px;height:76px;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:var(--chip)}
.extra-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.extra-thumb button{position:absolute;top:4px;right:4px;width:22px;height:22px;border-radius:50%;border:0;background:var(--ink);color:var(--bg);display:flex;align-items:center;justify-content:center;padding:0}
.fee-row{display:flex;justify-content:space-between;padding:6px 0;font-size:14px}
.fee-row.total{border-top:1px solid var(--line);margin-top:4px;padding-top:10px;font-weight:800}

/* Wallet */
.row-link{display:flex;align-items:center;justify-content:space-between;width:100%;background:transparent;border:0;border-bottom:1px solid var(--line);padding:14px 2px;font-weight:600;font-size:15px;text-align:left}
.row-link:last-child{border-bottom:0}
.danger-zone{border:1px solid var(--red);border-radius:18px;padding:16px;margin-bottom:14px}
.danger-zone .card-title{color:var(--red)}
.footer-links{display:flex;justify-content:center;gap:16px;font-size:13px;color:var(--muted);margin-top:8px}
.footer-links button{background:none;border:0;color:var(--muted);font-size:13px;text-decoration:underline;padding:4px}

/* Lists */
.item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
.icon-circle{width:38px;height:38px;border-radius:50%;background:var(--chip);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.icon-circle.credit{color:var(--green)}
.icon-circle.debit{color:var(--red)}
.item .mid{flex:1;min-width:0}
.item .t{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.item .s{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.item .amt{font-weight:800;font-size:14px;white-space:nowrap}
.credit{color:var(--green)}
.debit{color:var(--red)}
.chips{display:flex;gap:8px;overflow-x:auto;margin-bottom:12px;padding-bottom:4px}
.chip{background:var(--chip);border:1px solid transparent;border-radius:999px;padding:8px 14px;font-weight:600;font-size:13px;white-space:nowrap}
.chip.active{background:var(--ink);color:var(--bg)}
.badge{display:inline-block;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:700;background:var(--chip);color:var(--muted);text-transform:capitalize}
.b-paid,.b-approved,.b-released{background:rgba(22,163,74,0.15);color:var(--green)}
.b-pending,.b-held{background:rgba(217,119,6,0.15);color:var(--amber)}
.b-failed,.b-disputed{background:rgba(220,38,38,0.15);color:var(--red)}
.esc-card{border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:10px}
.esc-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px}
.esc-top .t{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.esc-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.esc-actions .btn{flex:1}

/* Bank */
.bank-wrap{position:relative}
.bank-list{display:none;position:absolute;left:0;right:0;top:100%;margin-top:4px;max-height:220px;overflow-y:auto;background:var(--card);border:1px solid var(--line);border-radius:12px;z-index:20}
.bank-list.open{display:block}
.bank-opt{padding:11px 12px;font-size:14px;border-bottom:1px solid var(--line);cursor:pointer}
.bank-opt:last-child{border-bottom:0}
.acct-name{display:none;align-items:center;gap:8px;color:var(--green);font-weight:700;font-size:14px;margin-bottom:12px}
.acct-name.show{display:flex}

/* Receipt */
.receipt-head{text-align:center;padding:10px 0 16px}
.check-circle{width:72px;height:72px;border-radius:50%;background:rgba(22,163,74,0.15);color:var(--green);display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.receipt-amount{font-size:32px;font-weight:800}
.kv{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}
.kv:last-child{border-bottom:0}
.kv .k{color:var(--muted)}
.kv .v{font-weight:600;text-align:right;word-break:break-all}

/* Legal */
.legal h3{font-size:15px;font-weight:800;margin:16px 0 6px}
.legal p{font-size:14px;color:var(--muted);margin-bottom:6px}

/* Tabbar */
.tabbar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:440px;background:var(--card);border-top:1px solid var(--line);display:flex;gap:4px;padding:8px 8px calc(8px + env(safe-area-inset-bottom));z-index:50}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;background:transparent;border:0;border-radius:14px;padding:7px 0;font-size:11px;font-weight:600;color:var(--muted)}
.tab.active{background:var(--chip);color:var(--ink)}

/* Sheets */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);display:none;align-items:flex-end;justify-content:center;z-index:100}
.overlay.open{display:flex}
.sheet{width:100%;max-width:440px;background:var(--card);color:var(--ink);border-radius:22px 22px 0 0;padding:20px 18px calc(20px + env(safe-area-inset-bottom));max-height:92vh;overflow-y:auto;border:1px solid var(--line)}
.sheet h3{font-size:18px;font-weight:800;margin-bottom:4px}
.sheet .sub{color:var(--muted);font-size:13px;margin-bottom:14px}
.amount-chips{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 12px}
.card-row{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:12px;margin-bottom:8px;font-size:14px}
.card-row .brand{font-weight:700;text-transform:capitalize}
.toggle-row{display:flex;justify-content:space-between;align-items:center;margin:6px 0 14px;font-size:14px;font-weight:600}
.toggle{width:46px;height:26px;border-radius:999px;background:var(--line);border:0;position:relative;padding:0}
.toggle::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .15s}
.toggle.on{background:var(--green)}
.toggle.on::after{left:23px}
.step{display:none}
.step.show{display:block}

/* PIN */
.pin-dots{display:flex;justify-content:center;gap:14px;margin:14px 0}
.pin-dots span{width:14px;height:14px;border-radius:50%;border:2px solid var(--ink)}
.pin-dots span.filled{background:var(--ink)}
.pin-error{color:var(--red);text-align:center;font-size:13px;font-weight:600;min-height:18px;margin-bottom:8px}
.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:8px 0 12px}
.key{background:var(--chip);border:0;border-radius:16px;height:56px;font-size:22px;font-weight:700;display:flex;align-items:center;justify-content:center}
.key.blank{background:transparent;cursor:default}

/* Toast */
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#000;color:#fff;border:1px solid #333;padding:11px 16px;border-radius:12px;font-size:14px;font-weight:600;z-index:3000;max-width:90%;text-align:center}

/* Gates */
.gate{position:fixed;inset:0;background:var(--bg);color:var(--ink);display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:24px;text-align:center;z-index:2000}
.gate.show{display:flex}
.gate h2{font-size:22px;font-weight:800}
.gate p{color:var(--muted);max-width:300px}
.gate .btn{width:auto;min-width:180px;text-decoration:none}
.spinner{width:38px;height:38px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--ink);animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ===== CHAT ===== */
#chat-product{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:12px;font-size:14px}
#chat-messages{display:flex;flex-direction:column;gap:8px;max-height:46vh;overflow-y:auto;margin-bottom:12px;padding:2px}
.chat-msg{max-width:85%;padding:10px 12px;border-radius:14px;font-size:14px;line-height:1.4;word-break:break-word;white-space:pre-wrap}
.chat-msg-user{align-self:flex-end;background:var(--ink);color:var(--bg);border-bottom-right-radius:4px}
.chat-msg-paylock{align-self:flex-start;background:var(--chip);color:var(--ink);border-bottom-left-radius:4px}
.chat-msg-peer{align-self:flex-start;background:var(--chip);color:var(--ink);border-bottom-left-radius:4px}
.chat-msg-system{align-self:center;background:transparent;border:1px solid var(--line);color:var(--muted);font-size:12.5px;text-align:center}
.chat-actions{display:flex;gap:8px;margin:12px 0}
.chat-actions .btn{flex:1}
.chat-inputbar{display:flex;gap:8px;align-items:center}
#chat-input{flex:1;min-width:0}
#chat-send{flex:none}

/* ===== BLOCK E - RATING ===== */
.rate-box { padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--ink); font-size: 14px; font-weight: 600; }
.rate-star { background: none; border: 0; padding: 0 4px; line-height: 1; cursor: pointer; color: var(--ink); }
.rate-star svg { display:block; fill: none; }
.rate-star.on svg { fill: currentColor; }
.rate-star:disabled { cursor: default; }

/* ===== MINOR FIXES 1-9 + BATCH 4 ===== */
.grid{ display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px; width:100%; }
.pcard{ min-width:0; overflow:hidden; cursor:pointer; }
.pcard .ptitle{ overflow:hidden; max-width:100%; }
.pcard .pprice{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
html,body{ overflow-x:hidden; }
.app-shell{ overflow-x:hidden; }

.gate h2,.gate p{text-align:center;line-height:1.35;overflow-wrap:anywhere}
.gate p{line-height:1.5;margin:0 auto}
.gate-logo{width:64px;height:64px;border-radius:50%;background:var(--chip);color:var(--ink);display:flex;align-items:center;justify-content:center;margin-bottom:4px}
.gate .gate-tg{width:100%;max-width:320px;min-width:0;margin-top:8px}

.chat-head{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--line);border-radius:14px;background:var(--card);margin-bottom:12px}
.chat-head .back-btn{margin:0;padding:8px 12px;flex:none}
.chat-head svg{flex:none}
.chat-head-txt{flex:1;min-width:0;text-align:left}
.chat-head-name{display:flex;align-items:center;gap:5px;font-weight:700;font-size:15px;line-height:1.2}
.chat-head-sub{font-size:12px;color:var(--muted);line-height:1.3;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-head-logo{color:var(--muted)}

.chat-list-mode #chat-root,.chat-list-mode #chat-empty{display:none!important}
#pg-chat:not(.chat-list-mode) #chat-list,
#pg-chat:not(.chat-list-mode) #chat-profiles,
#pg-chat:not(.chat-list-mode) #chat-orders,
#pg-chat:not(.chat-list-mode) #chat-support{display:none!important}
.chat-profiles{display:flex;gap:8px;overflow-x:auto;margin-bottom:12px;padding-bottom:2px}
.chat-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);cursor:pointer}
.chat-row:last-child{border-bottom:0}
.chat-thumb{width:48px;height:48px;border-radius:12px;background:var(--chip);object-fit:cover;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--muted)}
.chat-row .mid{flex:1;min-width:0;text-align:left}
.chat-row .t{font-weight:700;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-row .s{font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-meta{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.chat-time{font-size:11.5px;color:var(--muted)}
.chat-badge{min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--red);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center}
#support-thread{display:flex;flex-direction:column;gap:8px;max-height:50vh;overflow-y:auto;margin-bottom:12px;padding:2px}
.support-meta{font-size:11px;color:var(--muted);align-self:flex-end;margin-top:-4px}

.mk-bar{display:flex;justify-content:flex-end;margin:-6px 0 10px}
.mk-bar .chip{display:inline-flex;align-items:center;gap:6px}
.mk-search{margin-bottom:10px}

.pv-img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:16px;background:var(--chip);display:block;margin-bottom:14px}
.pv-price{font-size:22px;font-weight:800;margin-bottom:10px}
.pv-desc{font-size:14px;color:var(--muted);margin-bottom:14px;white-space:pre-wrap;word-break:break-word}
.pv-review{padding:8px 0;border-bottom:1px solid var(--line)}
.pv-review:last-child{border-bottom:0}
.pv-stars{display:flex;gap:2px;color:var(--ink)}
#pv-body .btn{margin-bottom:14px}

.esc-card .badge.b-held{margin-top:6px}

@media print{
  .tabbar,.btn,.btn-row,.back-btn,.toast,.overlay{display:none!important}
  .app-shell{padding:0;max-width:none}
}

/* ===== PAYLOCK ADDITIONS ===== */
.chat-msg-label{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--muted);margin-bottom:3px}
.chat-tick{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:var(--ink);color:var(--bg)}
#offline-banner{display:none;position:fixed;top:0;left:0;right:0;z-index:2500;align-items:center;justify-content:center;gap:10px;padding:10px 12px;padding-top:calc(10px + env(safe-area-inset-top));background:#000;color:#fff;font-size:13.5px;font-weight:600}
#offline-banner.show{display:flex}
#offline-banner button{background:#fff;color:#000;border:0;border-radius:8px;padding:5px 12px;font-weight:700;font-size:13px}
.ban-banner{display:none;align-items:center;justify-content:space-between;gap:10px;background:var(--red);color:#fff;border-radius:14px;padding:10px 12px;margin-bottom:12px;font-size:13px;font-weight:600}
.ban-banner .btn{background:#fff;color:#000;border-color:#fff;flex:none}
.skel{pointer-events:none}
.sk{background:var(--chip);border-radius:8px;animation:skpulse 1.2s ease-in-out infinite}
.sk-img{width:100%;aspect-ratio:1/1;border-radius:12px}
.sk-line{height:12px;width:80%}
.sk-line.short{width:45%}
@keyframes skpulse{0%,100%{opacity:1}50%{opacity:.45}}
.pc-meta{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pc-row{display:flex;align-items:center;justify-content:space-between;gap:6px}
.pc-row .pprice{min-width:0;flex:1}
.pc-icons{display:flex;gap:4px;flex:none}
.ic-btn{background:var(--chip);border:0;border-radius:8px;width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:var(--muted);padding:0}
.pv-thumbs{display:flex;gap:8px;margin:-6px 0 14px}
.pv-thumb{width:64px;height:64px;border-radius:10px;object-fit:cover;background:var(--chip);cursor:pointer;border:2px solid var(--line)}
.pv-thumb.active{border-color:var(--ink)}
